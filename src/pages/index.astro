---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import SongRecognitionHub from '../components/SongRecognitionHub.astro';
---

<Layout title="Music Finder AI - Identify Songs by Audio or Video">
  
  <!-- HERO SONG RECOGNITION HUB -->
  <SongRecognitionHub />

  <!-- SECTION 1: DARK TILE - ACOUSTIC FINGERPRINTING PRODUCT SHOWCASE -->
  <section id="technology" class="py-20 px-4 md:px-8 bg-[#272729] text-white">
    <div class="max-w-[1200px] mx-auto text-center space-y-8">
      <span class="text-[#2997ff] font-semibold text-sm uppercase tracking-widest block">Studio Grade Engine</span>
      
      <h2 class="font-display font-semibold text-3xl md:text-5xl tracking-[-0.025em] text-white leading-tight">
        Acoustic Fingerprinting Re-Engineered.
      </h2>

      <p class="text-xl md:text-2xl font-light text-neutral-300 max-w-3xl mx-auto leading-relaxed">
        Our deep audio engine analyzes spectral frequency peak maps in 200ms. It isolates melodies through noisy recordings, live cafes, and distorted video clips.
      </p>

      <!-- Photographic Audio Surface resting with system shadow per DESIGN.md -->
      <div class="pt-8">
        <div class="relative bg-[#1d1d1f] rounded-[24px] p-8 border border-neutral-800 shadow-product-render max-w-4xl mx-auto overflow-hidden">
          <div class="flex items-center justify-between text-xs text-neutral-400 mb-4 pb-4 border-b border-neutral-800">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#2997ff] animate-ping"></span>
              Real-time Spectrogram FFT Analysis
            </span>
            <span>22,050 Hz Dual Channel</span>
          </div>

          <!-- Animated Frequency Waves (CSS keyframe animation, no JS) -->
          <style>
            @keyframes bar-wave {
              0%, 100% { height: var(--bar-h-low); }
              50%       { height: var(--bar-h-high); }
            }
            .freq-bar {
              animation: bar-wave var(--bar-duration) ease-in-out infinite;
              animation-delay: var(--bar-delay);
            }
          </style>
          <div class="h-40 flex items-end justify-between gap-0.5 px-4">
            {Array.from({ length: 60 }).map((_, i) => {
              const base = Math.sin(i * 0.3) * 40 + 50 + (i % 5) * 6;
              const low  = Math.max(10, base * 0.35);
              const high = Math.min(100, base * 1.15);
              const dur  = (1.2 + (i % 7) * 0.18).toFixed(2);
              const del  = ((i % 11) * 0.09).toFixed(2);
              const op   = (0.4 + (i % 4) * 0.15).toFixed(2);
              return (
                <div
                  class="freq-bar flex-1 bg-gradient-to-t from-[#0066cc] to-[#2997ff] rounded-t-sm"
                  style={`--bar-h-low: ${low}%; --bar-h-high: ${high}%; --bar-duration: ${dur}s; --bar-delay: -${del}s; opacity: ${op};`}
                ></div>
              );
            })}
          </div>

          <div class="mt-6 flex items-center justify-between text-xs text-neutral-400 pt-4 border-t border-neutral-800">
            <span>Signal-to-Noise Ratio: +42dB</span>
            <span class="text-[#2997ff] font-mono">Fingerprint Hash: 0x9F82A4C01</span>
          </div>
        </div>

        <div class="mt-8">
          <a href="/technology" class="inline-flex items-center gap-2 text-sm text-[#2997ff] hover:text-[#52adff] transition-colors font-medium">
            Explore Full Technology Architecture & FFT Specs &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: LIGHT TILE - WHY MUSIC FINDER AI IS BETTER -->
  <section id="comparison" class="py-20 px-4 md:px-8 bg-canvas">
    <div class="max-w-[1100px] mx-auto">
      
      <div class="text-center mb-16">
        <span class="text-[#0066cc] dark:text-[#2997ff] font-semibold text-sm uppercase tracking-wider block mb-2">Unmatched Performance</span>
        <h2 class="font-display font-semibold text-3xl md:text-5xl tracking-[-0.025em] text-ink">
          Why Music Finder AI Outperforms Competitors
        </h2>
        <p class="text-lg text-muted-adaptive mt-3">
          Designed for pro creators, listeners, and musicians who expect studio precision without ad noise.
        </p>
      </div>

      <!-- Comparison Matrix Table (explicit column widths prevent feature col overstretching) -->
      <div class="overflow-x-auto rounded-[20px] border border-adaptive shadow-sm">
        <table class="w-full text-left border-collapse bg-canvas text-sm">
          <colgroup>
            <col style="width: 30%" />
            <col style="width: 35%" />
            <col style="width: 35%" />
          </colgroup>
          <thead>
            <tr class="bg-surface-card border-b border-adaptive">
              <th class="p-4 md:p-6 font-semibold text-ink">Feature / Capability</th>
              <th class="p-4 md:p-6 font-semibold text-[#0066cc] dark:text-[#2997ff] bg-[#0066cc]/5 border-l-2 border-[#0066cc]/30">Music Finder AI</th>
              <th class="p-4 md:p-6 font-semibold text-muted-adaptive">Legacy Recognition Tools</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-adaptive">
            <tr>
              <td class="p-4 md:p-6 font-medium text-ink">Ad Experience & Interface</td>
              <td class="p-4 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]/30">100% Ad-Free Clean UI</td>
              <td class="p-4 md:p-6 text-muted-adaptive">Cluttered Banner Ads & Popups</td>
            </tr>
            <tr>
              <td class="p-4 md:p-6 font-medium text-ink">Input Modes</td>
              <td class="p-4 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]/30">Audio, Video Extraction, URL Stream & Live Mic</td>
              <td class="p-4 md:p-6 text-muted-adaptive">Audio upload only</td>
            </tr>
            <tr>
              <td class="p-4 md:p-6 font-medium text-ink">Match Speed & Precision</td>
              <td class="p-4 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]/30">Sub-second 200ms Acoustic Matching</td>
              <td class="p-4 md:p-6 text-muted-adaptive">Slow multi-second processing queue</td>
            </tr>
            <tr>
              <td class="p-4 md:p-6 font-medium text-ink">Pre-Recognition Audio Cleanup</td>
              <td class="p-4 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]/30">Volume Normalize, Vocal Isolation, Waveform Crop</td>
              <td class="p-4 md:p-6 text-muted-adaptive">Manual basic trimming only</td>
            </tr>
            <tr>
              <td class="p-4 md:p-6 font-medium text-ink">Recognition History</td>
              <td class="p-4 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]/30">Persistent Local Storage Drawer</td>
              <td class="p-4 md:p-6 text-muted-adaptive">Lost on page refresh</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-8 text-center">
        <a href="/comparison" class="inline-flex items-center gap-2 text-sm text-[#0066cc] dark:text-[#2997ff] hover:underline font-medium">
          View Complete Comparison Matrix, Differentiators & Platform Showdowns &rarr;
        </a>
      </div>

    </div>
  </section>

  <!-- SECTION 3: PARCHMENT TILE - FAQ ACCORDION -->
  <section id="faq" class="py-20 px-4 md:px-8 bg-parchment border-t border-adaptive">
    <div class="max-w-[840px] mx-auto space-y-12">
      
      <div class="text-center">
        <h2 class="font-display font-semibold text-3xl md:text-4xl text-ink">
          Frequently Asked Questions
        </h2>
        <p class="text-muted-adaptive mt-2">Everything you need to know about song recognition & acoustic fingerprinting.</p>
      </div>

      <div class="space-y-4">
        <details class="group bg-canvas p-6 rounded-2xl border border-adaptive [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-semibold text-lg text-ink">
            <span>What audio and video formats are supported?</span>
            <svg class="w-5 h-5 text-muted-adaptive transition-transform duration-200 group-open:rotate-180 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="text-sm text-muted-adaptive mt-3 leading-relaxed">
            We support all major audio formats including MP3, WAV, FLAC, M4A, AAC, OGG, OPUS, ALAC, and AIFF. We also support video formats such as MP4, WebM, MKV, AVI, and MOV by automatically extracting the audio track.
          </p>
        </details>

        <details class="group bg-canvas p-6 rounded-2xl border border-adaptive [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-semibold text-lg text-ink">
            <span>How does song recognition work on noisy recordings?</span>
            <svg class="w-5 h-5 text-muted-adaptive transition-transform duration-200 group-open:rotate-180 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="text-sm text-muted-adaptive mt-3 leading-relaxed">
            Our engine builds an acoustic fingerprint map of spectral frequency peaks. For noisy audio, you can use our built-in pre-processing suite (Vocal Isolation, Volume Normalization, or Crop Slider) right inside the recognition hub before running fingerprint analysis.
          </p>
        </details>

        <details class="group bg-canvas p-6 rounded-2xl border border-adaptive [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-semibold text-lg text-ink">
            <span>Is my uploaded audio file stored on your servers?</span>
            <svg class="w-5 h-5 text-muted-adaptive transition-transform duration-200 group-open:rotate-180 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="text-sm text-muted-adaptive mt-3 leading-relaxed">
            No. Your privacy is paramount. Uploaded audio files are analyzed securely and immediately purged after fingerprinting. Audio processing runs locally whenever possible.
          </p>
        </details>

        <details class="group bg-canvas p-6 rounded-2xl border border-adaptive [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-semibold text-lg text-ink">
            <span>Is Music Finder AI free to use?</span>
            <svg class="w-5 h-5 text-muted-adaptive transition-transform duration-200 group-open:rotate-180 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="text-sm text-muted-adaptive mt-3 leading-relaxed">
            Yes! Music Finder AI is 100% free with unlimited song identifications, video extractions, and live microphone capture with no sign-ups or software installation required.
          </p>
        </details>
      </div>

    </div>
  </section>

</Layout>
