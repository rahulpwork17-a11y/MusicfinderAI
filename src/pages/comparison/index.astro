---
// src/pages/comparison/index.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Music Finder AI vs Alternatives - Comparison & Benchmark"
  description="Compare Music Finder AI against Shazam, SoundHound, AHA Music, and legacy audio identification tools. Discover our 100% ad-free interface, video audio extraction, and studio preprocessing suite."
>
  <!-- HERO: COMPARISON OVERVIEW
    {component.product-tile-light}: bg {colors.canvas}, padding {spacing.section} 80px.
    NO decorative blobs, NO gradient text, NO border-b divider — tile boundary = color change.
    Single Action Blue {colors.primary} for all interactive accents.
  -->
  <section class="px-4 sm:px-6 md:px-8 bg-canvas py-12 sm:py-16 md:py-20 lg:py-24">
    <div class="max-w-[1200px] mx-auto text-center flex flex-col gap-6 sm:gap-8">

      <!-- Eyebrow — {typography.caption-strong}: 14px / 600 / 1.29 / -0.224px -->
      <div
        class="inline-flex items-center gap-2 mx-auto text-[#0066cc] dark:text-[#2997ff] px-3.5 py-1.5 rounded-full border border-blue-500/20 bg-blue-500/5 text-xs font-semibold uppercase tracking-wider"
      >
        Platform Benchmarks 2026
      </div>

      <!-- Hero h1 — {typography.hero-display}: 56px / 600 / 1.07 / -0.28px.
        Solid {colors.ink} — NO gradient text. The single blue accent is in the eyebrow above.
        Responsive: 56px desktop → 40px tablet → 34px mobile (per design.md §Responsive)
      -->
      <h1 class="font-display text-ink text-3xl sm:text-4xl md:text-5xl lg:text-[56px] font-semibold leading-[1.1] tracking-tight m-0">
        Why Creators &amp; Listeners Choose Music Finder AI.
      </h1>

      <!-- Lead — {typography.lead-airy}: 24px / 300 / 1.5 / 0 -->
      <p class="text-muted-adaptive max-w-3xl mx-auto text-base sm:text-lg md:text-xl lg:text-2xl font-light leading-relaxed m-0">
        Legacy recognition tools are bloated with intrusive ads, restricted to live microphone input, and lack video extraction. We built the fast, ad-free studio tool you deserve.
      </p>

      <!-- Key Differentiator Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
        {[
          "100% Ad-Free",
          "Video & URL Extraction",
          "Studio Vocal & Gain Filters",
          "Zero File Logging",
        ].map(label => (
          <span
            class="flex items-center gap-1.5 text-[#0066cc] dark:text-[#2997ff] px-3 py-1.5 rounded-lg bg-blue-500/10 border border-blue-500/20 text-xs font-medium"
          >
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            {label}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION: THE FULL COMPARISON MATRIX
    {component.product-tile-parchment}: bg {colors.canvas-parchment}, padding {spacing.section} 80px.
  -->
  <section class="px-4 sm:px-6 md:px-8 bg-parchment py-12 sm:py-16 md:py-20 lg:py-24">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-8 sm:mb-12">
        <!-- Eyebrow — {typography.caption-strong}: 14px / 600 / 1.29 / -0.224px -->
        <span class="text-[#0066cc] dark:text-[#2997ff] block text-xs sm:text-sm font-semibold uppercase tracking-wider mb-2">Comprehensive Breakdown</span>
        <!-- h2 — {typography.display-lg}: 40px / 600 / 1.10 / 0 -->
        <h2 class="font-display text-ink text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-semibold leading-tight mb-2">
          Feature-by-Feature Comparison Matrix
        </h2>
        <!-- Body — {typography.body}: 17px / 400 / 1.47 / -0.374px -->
        <p class="text-muted-adaptive text-sm sm:text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          See how Music Finder AI compares side-by-side with mainstream recognition platforms.
        </p>
      </div>

      <!-- Table container — {rounded.lg} = 18px, 1px hairline border, NO shadow -->
      <div class="overflow-x-auto border border-adaptive bg-canvas rounded-xl sm:rounded-2xl -mx-1 sm:mx-0">
        <table class="w-full text-left border-collapse text-xs sm:text-sm min-w-[540px]">
          <thead>
            <tr class="bg-surface-card border-b border-adaptive">
              <th class="p-3.5 sm:p-5 md:p-6 font-bold text-ink w-[30%]">Capability / Feature</th>
              <th class="p-3.5 sm:p-5 md:p-6 font-bold text-[#0066cc] dark:text-[#2997ff] bg-[#0066cc]/5 border-l-2 border-[#0066cc] w-[35%]">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#0066cc] dark:bg-[#2997ff]"></span>
                  Music Finder AI
                </div>
              </th>
              <th class="p-3.5 sm:p-5 md:p-6 font-bold text-muted-adaptive w-[35%]">
                Legacy Recognition Tools
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-adaptive">
            <!-- Row: Ad Experience -->
            <tr class="hover:bg-surface-card/50 transition-colors">
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-ink">
                Ad Experience &amp; Clutter
                <span class="block text-[11px] sm:text-xs font-normal text-muted-adaptive mt-0.5">Distraction-free usage without banners</span>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  100% Ad-Free, No Popups or Banners
                </div>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 text-muted-adaptive">
                Heavily monetized with banner ads, interstitial popups, and click redirections
              </td>
            </tr>

            <!-- Row: Video Track Extraction -->
            <tr class="hover:bg-surface-card/50 transition-colors">
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-ink">
                Video Audio Extraction
                <span class="block text-[11px] sm:text-xs font-normal text-muted-adaptive mt-0.5">MP4, WebM, MOV, MKV support</span>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Direct Video Demuxing in Browser
                </div>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 text-muted-adaptive">
                Requires manual conversion to MP3 via 3rd party converter first
              </td>
            </tr>

            <!-- Row: Input Flexibility -->
            <tr class="hover:bg-surface-card/50 transition-colors">
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-ink">
                Input Methods
                <span class="block text-[11px] sm:text-xs font-normal text-muted-adaptive mt-0.5">How you can feed audio into the engine</span>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Audio File, Video File, URL Stream &amp; Live Mic
                </div>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 text-muted-adaptive">
                Usually restricted to Live Mic only (App) or single audio format (Web)
              </td>
            </tr>

            <!-- Row: Pre-Processing Studio Tools -->
            <tr class="hover:bg-surface-card/50 transition-colors">
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-ink">
                Audio Pre-Processing Suite
                <span class="block text-[11px] sm:text-xs font-normal text-muted-adaptive mt-0.5">Vocal isolation, gain boost, trim slider</span>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Integrated Browser Audio Tools
                </div>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 text-muted-adaptive">
                None. Raw audio is processed as-is with high error rate on noisy clips
              </td>
            </tr>

            <!-- Row: Match Speed -->
            <tr class="hover:bg-surface-card/50 transition-colors">
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-ink">
                Match Speed &amp; Latency
                <span class="block text-[11px] sm:text-xs font-normal text-muted-adaptive mt-0.5">Time to return identified track</span>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Sub-second (Average 200ms)
                </div>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 text-muted-adaptive">
                4 to 12 seconds with server upload queue delay
              </td>
            </tr>

            <!-- Row: History & Offline Drawer -->
            <tr class="hover:bg-surface-card/50 transition-colors">
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-ink">
                Recognition History
                <span class="block text-[11px] sm:text-xs font-normal text-muted-adaptive mt-0.5">Persistence across sessions</span>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Local Storage History (No Account Needed)
                </div>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 text-muted-adaptive">
                Lost on page refresh, or requires mandatory account sign up
              </td>
            </tr>

            <!-- Row: Privacy & Security -->
            <tr class="hover:bg-surface-card/50 transition-colors">
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-ink">
                Data Privacy &amp; Retention
                <span class="block text-[11px] sm:text-xs font-normal text-muted-adaptive mt-0.5">Handling of uploaded audio and voice data</span>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Instant In-Memory Purge, No Tracking
                </div>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 text-muted-adaptive">
                Audio stored for advertising telemetry and profiling
              </td>
            </tr>

            <!-- Row: Streaming Outlinks -->
            <tr class="hover:bg-surface-card/50 transition-colors">
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-ink">
                Streaming Platform Links
                <span class="block text-[11px] sm:text-xs font-normal text-muted-adaptive mt-0.5">Listen directly on your preferred service</span>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-[#0066cc]/5 border-l-2 border-[#0066cc]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Spotify, Apple Music &amp; YouTube Music
                </div>
              </td>
              <td class="p-3.5 sm:p-5 md:p-6 text-muted-adaptive">
                Locked to single proprietary ecosystem
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SECTION: HEAD-TO-HEAD BREAKDOWNS -->
  <section class="py-12 sm:py-20 px-4 sm:px-6 md:px-8 bg-canvas">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
        <span class="text-[#0066cc] dark:text-[#2997ff] font-semibold text-xs sm:text-sm uppercase tracking-wider block mb-2">Direct Showdown</span>
        <h2 class="font-display font-semibold text-2xl sm:text-3xl md:text-4xl lg:text-5xl tracking-tight text-ink">
          Head-to-Head Comparisons
        </h2>
        <p class="text-sm sm:text-base md:text-lg text-muted-adaptive mt-2 sm:mt-3 leading-relaxed">
          Detailed technical differences between Music Finder AI and individual alternatives.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <!-- Card 1: Shazam -->
        <div class="p-6 sm:p-8 rounded-2xl sm:rounded-3xl bg-surface-card border border-adaptive flex flex-col justify-between hover:shadow-lg transition-all">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-blue-500/10 text-[#0066cc] dark:text-[#2997ff] flex items-center justify-center font-bold text-xl mb-5">
              VS
            </div>
            <h3 class="text-xl sm:text-2xl font-bold font-display text-ink mb-2">Music Finder AI vs Shazam</h3>
            <p class="text-xs sm:text-sm text-muted-adaptive leading-relaxed mb-5">
              Shazam is great for ambient mic listening on phones, but falls short on desktops and creator workflows. It lacks native video file extraction, audio trimming, and vocal isolation tools.
            </p>
            <ul class="space-y-2 text-xs text-muted-adaptive">
              <li class="flex items-center gap-2 text-ink font-medium">
                <span class="text-emerald-500 font-bold">&check;</span> Works in browser without downloading apps
              </li>
              <li class="flex items-center gap-2 text-ink font-medium">
                <span class="text-emerald-500 font-bold">&check;</span> Direct MP4/MKV video audio demuxing
              </li>
              <li class="flex items-center gap-2 text-ink font-medium">
                <span class="text-emerald-500 font-bold">&check;</span> Unrestricted multi-platform streaming links
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-adaptive text-xs font-semibold text-[#0066cc] dark:text-[#2997ff]">
            Ideal for: Video Editors &amp; Content Creators
          </div>
        </div>

        <!-- Card 2: SoundHound -->
        <div class="p-6 sm:p-8 rounded-2xl sm:rounded-3xl bg-surface-card border border-adaptive flex flex-col justify-between hover:shadow-lg transition-all">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-xl mb-5">
              VS
            </div>
            <h3 class="text-xl sm:text-2xl font-bold font-display text-ink mb-2">Music Finder AI vs SoundHound</h3>
            <p class="text-xs sm:text-sm text-muted-adaptive leading-relaxed mb-5">
              SoundHound specializes in melody humming, but its web presence is dated and saturated with third-party tracking. Music Finder AI provides modern, sub-second spectral matching with 100% privacy.
            </p>
            <ul class="space-y-2 text-xs text-muted-adaptive">
              <li class="flex items-center gap-2 text-ink font-medium">
                <span class="text-emerald-500 font-bold">&check;</span> 200ms sub-second constellation matching
              </li>
              <li class="flex items-center gap-2 text-ink font-medium">
                <span class="text-emerald-500 font-bold">&check;</span> Clean modern UI with Light &amp; Dark modes
              </li>
              <li class="flex items-center gap-2 text-ink font-medium">
                <span class="text-emerald-500 font-bold">&check;</span> Zero invasive tracker scripts or cookies
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-adaptive text-xs font-semibold text-[#0066cc] dark:text-[#2997ff]">
            Ideal for: Audiophiles &amp; Privacy-Conscious Users
          </div>
        </div>

        <!-- Card 3: Generic Ad-Heavy Web Uploaders -->
        <div class="p-6 sm:p-8 rounded-2xl sm:rounded-3xl bg-surface-card border border-adaptive flex flex-col justify-between hover:shadow-lg transition-all">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-purple-500/10 text-purple-500 flex items-center justify-center font-bold text-xl mb-5">
              VS
            </div>
            <h3 class="text-xl sm:text-2xl font-bold font-display text-ink mb-2">Music Finder AI vs Ad Uploaders</h3>
            <p class="text-xs sm:text-sm text-muted-adaptive leading-relaxed mb-5">
              Many online "song identifier" websites are ad traps that redirect to suspicious extensions or bombard users with popups. Music Finder AI is an ad-free, verified acoustic tool.
            </p>
            <ul class="space-y-2 text-xs text-muted-adaptive">
              <li class="flex items-center gap-2 text-ink font-medium">
                <span class="text-emerald-500 font-bold">&check;</span> 100% Ad-Free, No Fake Download Buttons
              </li>
              <li class="flex items-center gap-2 text-ink font-medium">
                <span class="text-emerald-500 font-bold">&check;</span> Client-side WebAudio processing
              </li>
              <li class="flex items-center gap-2 text-ink font-medium">
                <span class="text-emerald-500 font-bold">&check;</span> 30s Audio previews &amp; rich track metadata
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-adaptive text-xs font-semibold text-[#0066cc] dark:text-[#2997ff]">
            Ideal for: Fast, Safe Daily Music Discovery
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION: COMPARISON FAQ -->
  <section class="py-12 sm:py-20 px-4 sm:px-6 md:px-8 bg-parchment border-t border-adaptive">
    <div class="max-w-[840px] mx-auto space-y-8 sm:space-y-12">
      <div class="text-center">
        <h2 class="font-display font-semibold text-2xl sm:text-3xl md:text-4xl text-ink">
          Comparison Questions &amp; Answers
        </h2>
        <p class="text-muted-adaptive text-sm sm:text-base mt-2">Common questions regarding alternatives and capabilities.</p>
      </div>

      <div class="space-y-3 sm:space-y-4">
        <details class="group bg-canvas p-4 sm:p-6 rounded-xl sm:rounded-2xl border border-adaptive [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-semibold text-base sm:text-lg text-ink">
            <span class="pr-3">Can I identify songs from YouTube, TikTok, or Instagram video clips?</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-muted-adaptive transition-transform duration-200 group-open:rotate-180 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="text-xs sm:text-sm text-muted-adaptive mt-3 leading-relaxed pt-3 border-t border-adaptive">
            Yes! Unlike mobile-only apps, you can drag and drop any MP4, WebM, MKV, or MOV video file directly into Music Finder AI. We extract the audio track in milliseconds and identify the background track even through dialogue.
          </p>
        </details>

        <details class="group bg-canvas p-4 sm:p-6 rounded-xl sm:rounded-2xl border border-adaptive [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-semibold text-base sm:text-lg text-ink">
            <span class="pr-3">Why is Music Finder AI ad-free and free to use?</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-muted-adaptive transition-transform duration-200 group-open:rotate-180 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="text-xs sm:text-sm text-muted-adaptive mt-3 leading-relaxed pt-3 border-t border-adaptive">
            We believe audio recognition should be fast, clean, and accessible without visual clutter. Our acoustic fingerprinting engine runs ultra-efficient vectorized lookups with low overhead, allowing us to offer high-speed song identification without relying on disruptive display ads.
          </p>
        </details>

        <details class="group bg-canvas p-4 sm:p-6 rounded-xl sm:rounded-2xl border border-adaptive [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-semibold text-base sm:text-lg text-ink">
            <span class="pr-3">How does the Pre-Processing Suite improve match accuracy?</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-muted-adaptive transition-transform duration-200 group-open:rotate-180 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="text-xs sm:text-sm text-muted-adaptive mt-3 leading-relaxed pt-3 border-t border-adaptive">
            On noisy recordings, our Vocal Isolation and Volume Normalization filters remove unwanted background frequencies and level out clipped or quiet audio before the fingerprint is calculated. This yields significantly higher match rates compared to tools that process raw, distorted signals.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="py-12 sm:py-20 px-4 sm:px-6 md:px-8 bg-canvas border-t border-adaptive text-center">
    <div class="max-w-[700px] mx-auto space-y-4 sm:space-y-6">
      <h2 class="font-display font-semibold text-2xl sm:text-3xl md:text-4xl text-ink">
        Ready for Better Song Recognition?
      </h2>
      <p class="text-muted-adaptive text-sm sm:text-base md:text-lg max-w-xl mx-auto">
        Try Music Finder AI now — 100% ad-free, instant, and completely free.
      </p>
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto">
        <a href="/#recognizer" class="btn-action-primary !py-3 !px-8 !text-sm sm:!text-base w-full sm:w-auto justify-center">
          Start Identifying Now
        </a>
        <a href="/technology" class="btn-action-secondary !py-3 !px-8 !text-sm sm:!text-base w-full sm:w-auto justify-center">
          Explore the Technology
        </a>
      </div>
    </div>
  </section>
</Layout>
