---
// src/pages/tools/key-detector.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'key-notation', label: 'Primary Notation Style', type: 'select' as const, default: 'Camelot Wheel Code (DJ)', options: ['Camelot Wheel Code (DJ)', 'Standard Musical Key (e.g., A Minor)', 'Open Key Notation (e.g., 1m)'] },
];

const CAMELOT_ITEMS = [
  { code: "1A", key: "A♭m" }, { code: "2A", key: "E♭m" }, { code: "3A", key: "B♭m" }, { code: "4A", key: "Fm" }, { code: "5A", key: "Cm" }, { code: "6A", key: "Gm" },
  { code: "7A", key: "Dm" }, { code: "8A", key: "Am" }, { code: "9A", key: "Em" }, { code: "10A", key: "Bm" }, { code: "11A", key: "F♯m" }, { code: "12A", key: "D♭m" },
  { code: "1B", key: "B" }, { code: "2B", key: "F♯" }, { code: "3B", key: "D♭" }, { code: "4B", key: "A♭" }, { code: "5B", key: "E♭" }, { code: "6B", key: "B♭" },
  { code: "7B", key: "F" }, { code: "8B", key: "C" }, { code: "9B", key: "G" }, { code: "10B", key: "D" }, { code: "11B", key: "A" }, { code: "12B", key: "E" },
];
---

<Layout title="Musical Key & Scale Detector - Music Finder AI" subnavTitle="Key Detector" activeTool="Key">
  <InteractiveAudioTool
    toolName="Musical Key & Camelot Wheel Detector"
    toolDescription="Detect musical key, scale, and Camelot wheel code for DJ harmonic mixing, mashups, and song arrangement."
    icon="🔑"
    badge="Harmonic Pitch Analysis"
    controls={controls}
    exportFormats={["Key Report (JSON)", "Harmonic Mixing Sheet"]}
  >
    <!-- Key Analysis Result Summary Card -->
    <div id="key-results-card" class="mt-6 bg-surface-card p-6 md:p-8 rounded-2xl border border-adaptive space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff]">Harmonic Chromagram Profile</span>
          <h3 class="text-xl font-bold text-ink mt-0.5">Detected Musical Key</h3>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-[#0066cc]/10 text-[#0066cc] dark:text-[#2997ff] font-semibold" id="key-confidence-tag">
          Confidence: --%
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Big Key Display -->
        <div class="p-6 rounded-2xl bg-canvas border border-adaptive text-center">
          <span class="text-xs font-medium text-muted-adaptive uppercase tracking-wider">Root Key & Scale</span>
          <div class="text-4xl font-display font-extrabold text-[#0066cc] dark:text-[#2997ff] my-2" id="key-name-display">
            ---
          </div>
          <span class="text-xs font-semibold text-ink px-3 py-1 rounded-full bg-parchment border border-adaptive inline-block" id="key-scale-display">
            Upload file to detect
          </span>
        </div>

        <!-- Camelot & Open Key Display -->
        <div class="p-6 rounded-2xl bg-canvas border border-adaptive flex flex-col justify-center gap-4">
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-adaptive">Camelot DJ Code:</span>
            <span class="text-2xl font-bold text-ink font-mono" id="camelot-code-display">--</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-adaptive">Open Key Code:</span>
            <span class="text-xl font-bold text-ink font-mono" id="open-key-display">--</span>
          </div>
        </div>

        <!-- Compatible Mixing Keys -->
        <div class="p-6 rounded-2xl bg-canvas border border-adaptive space-y-2">
          <span class="text-xs text-muted-adaptive uppercase tracking-wider block">Harmonic Mixing Targets</span>
          <div class="text-xs text-ink space-y-1.5 font-mono" id="compatible-keys-list">
            <div>• Adjacent Key: <span class="text-[#0066cc] dark:text-[#2997ff] font-bold" id="comp-adjacent">--</span></div>
            <div>• Energy Boost (+1): <span class="text-[#0066cc] dark:text-[#2997ff] font-bold" id="comp-boost">--</span></div>
            <div>• Relative Mode: <span class="text-[#0066cc] dark:text-[#2997ff] font-bold" id="comp-relative">--</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Camelot Wheel Visual Graphic -->
    <div class="mt-6 bg-[#1d1d1f] text-white p-6 md:p-8 rounded-2xl border border-neutral-800 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h4 class="font-semibold text-sm text-white">Interactive Camelot Wheel Position</h4>
          <p class="text-xs text-neutral-400">Highlighted segment indicates detected key and harmonic relations</p>
        </div>
        <span class="text-xs text-[#2997ff] font-medium font-mono">Harmonic Mixing Ready</span>
      </div>

      <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-12 gap-2 text-center text-xs font-mono" id="camelot-grid">
        {CAMELOT_ITEMS.map((k) => (
          <div
            data-camelot={k.code}
            class="camelot-cell p-2.5 rounded-xl border bg-white/5 border-white/10 text-neutral-300 transition-all duration-300"
          >
            <div class="text-sm font-bold">{k.code}</div>
            <div class="text-[10px] text-neutral-400">{k.key}</div>
          </div>
        ))}
      </div>
    </div>
  </InteractiveAudioTool>

  <script>
    import { detectKeyFromBuffer, downloadBlob } from '../../utils/audioEngine';

    function setupKeyDetector() {
      const keyNameDisplay = document.getElementById('key-name-display');
      const keyScaleDisplay = document.getElementById('key-scale-display');
      const camelotDisplay = document.getElementById('camelot-code-display');
      const openKeyDisplay = document.getElementById('open-key-display');
      const confidenceTag = document.getElementById('key-confidence-tag');
      const compAdjacent = document.getElementById('comp-adjacent');
      const compBoost = document.getElementById('comp-boost');
      const compRelative = document.getElementById('comp-relative');
      const cells = document.querySelectorAll('.camelot-cell');

      let lastResult: any = null;

      window.addEventListener('audio-loaded', ((e: CustomEvent) => {
        const { buffer, filename } = e.detail;
        if (!buffer) return;

        const result = detectKeyFromBuffer(buffer);
        lastResult = { ...result, filename };

        if (keyNameDisplay) keyNameDisplay.textContent = `${result.key} ${result.scale}`;
        if (keyScaleDisplay) keyScaleDisplay.textContent = `${result.scale} Diatonic Scale`;
        if (camelotDisplay) camelotDisplay.textContent = result.camelot;
        if (openKeyDisplay) openKeyDisplay.textContent = result.openKey;
        if (confidenceTag) confidenceTag.textContent = `Confidence: ${result.confidence}%`;

        // Calculate Harmonic Compatibility
        const num = parseInt(result.camelot);
        const letter = result.camelot.replace(/[0-9]/g, '');
        const prevNum = num === 1 ? 12 : num - 1;
        const nextNum = num === 12 ? 1 : num + 1;
        const oppLetter = letter === 'A' ? 'B' : 'A';

        if (compAdjacent) compAdjacent.textContent = `${prevNum}${letter} & ${nextNum}${letter}`;
        if (compBoost) compBoost.textContent = `${nextNum}${letter} (Higher Energy)`;
        if (compRelative) compRelative.textContent = `${num}${oppLetter} (Mood Switch)`;

        // Highlight Camelot Grid
        cells.forEach((cell) => {
          const cCode = (cell as HTMLElement).dataset.camelot;
          const isTarget = cCode === result.camelot;
          const isAdjacent = cCode === `${prevNum}${letter}` || cCode === `${nextNum}${letter}` || cCode === `${num}${oppLetter}`;

          if (isTarget) {
            cell.className = 'camelot-cell p-2.5 rounded-xl border bg-[#0066cc] text-white font-bold border-white/60 shadow-lg scale-105 ring-2 ring-[#2997ff]';
          } else if (isAdjacent) {
            cell.className = 'camelot-cell p-2.5 rounded-xl border bg-[#0066cc]/30 text-white font-semibold border-[#2997ff]/40';
          } else {
            cell.className = 'camelot-cell p-2.5 rounded-xl border bg-white/5 border-white/10 text-neutral-300';
          }
        });
      }) as EventListener);

      // Handle Download
      window.addEventListener('audio-custom-download', ((e: CustomEvent) => {
        if (!lastResult) return;
        e.preventDefault();
        const jsonBlob = new Blob([JSON.stringify(lastResult, null, 2)], { type: 'application/json' });
        downloadBlob(jsonBlob, `${lastResult.filename || 'track'}_key_report.json`);
      }) as EventListener);
    }

    setupKeyDetector();
    document.addEventListener('astro:page-load', setupKeyDetector);
  </script>
</Layout>
