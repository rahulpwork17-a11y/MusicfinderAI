---
// src/pages/tools/mood-detector.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'mood-model', label: 'AI Mood Classification Model', type: 'select' as const, default: 'Full Valence-Arousal Matrix', options: ['Full Valence-Arousal Matrix', 'Genre Emotional Classifier', 'Fitness & Energy Classifier'] },
];
---

<Layout title="AI Track Mood & Vibe Analyzer - Music Finder AI" subnavTitle="Mood Detector" activeTool="Mood">
  <InteractiveAudioTool
    toolName="AI Track Mood, Energy & Valence Analyzer"
    toolDescription="Analyze track energy, danceability ratings, emotional valence, and mood tags using deep AI audio analysis."
    icon="⚡"
    badge="AI Audio Intelligence"
    controls={controls}
    exportFormats={["JSON Specs", "Mood PDF Sheet"]}
  >
    <!-- Mood Scores Card -->
    <div class="mt-6 bg-surface-card p-6 rounded-2xl border border-adaptive space-y-4">
      <h4 class="font-semibold text-sm text-ink">Track Audio Attributes</h4>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-4 rounded-xl bg-canvas border border-adaptive">
          <span class="text-xs text-muted-adaptive">Energy Score</span>
          <div class="text-2xl font-bold text-ink mt-1">88 / 100</div>
          <div class="w-full bg-parchment h-2 rounded-full mt-2 border border-adaptive">
            <div class="bg-[#0066cc] dark:bg-[#2997ff] h-2 rounded-full" style="width: 88%"></div>
          </div>
        </div>
        <div class="p-4 rounded-xl bg-canvas border border-adaptive">
          <span class="text-xs text-muted-adaptive">Danceability</span>
          <div class="text-2xl font-bold text-ink mt-1">79 / 100</div>
          <div class="w-full bg-parchment h-2 rounded-full mt-2 border border-adaptive">
            <div class="bg-[#0066cc] dark:bg-[#2997ff] h-2 rounded-full" style="width: 79%"></div>
          </div>
        </div>
        <div class="p-4 rounded-xl bg-canvas border border-adaptive">
          <span class="text-xs text-muted-adaptive">Valence (Positivity)</span>
          <div class="text-2xl font-bold text-ink mt-1">65 / 100</div>
          <div class="w-full bg-parchment h-2 rounded-full mt-2 border border-adaptive">
            <div class="bg-[#0066cc] dark:bg-[#2997ff] h-2 rounded-full" style="width: 65%"></div>
          </div>
        </div>
      </div>
    </div>
  </InteractiveAudioTool>
</Layout>
