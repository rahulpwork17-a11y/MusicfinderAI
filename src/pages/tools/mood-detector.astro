---
// src/pages/tools/mood-detector.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'mood-model', label: 'AI Mood Classification Model', type: 'select' as const, default: 'Full Valence-Arousal Matrix', options: ['Full Valence-Arousal Matrix', 'Genre Emotional Classifier', 'Fitness & Energy Classifier'] },
];
---

<Layout title="AI Track Mood & Vibe Analyzer - Music Finder AI" subnavTitle="Mood Detector" activeTool="Mood">
  <InteractiveAudioTool
    toolName="AI Track Mood, Energy & Valence Analyzer"
    toolDescription="Analyze track energy, danceability ratings, emotional valence, and mood tags using client-side acoustic intelligence."
    icon="⚡"
    badge="AI Audio Intelligence"
    controls={controls}
    exportFormats={["JSON Specs", "Mood Attribute Report"]}
  >
    <!-- Mood Scores Card -->
    <div id="mood-results-card" class="mt-6 bg-surface-card p-6 md:p-8 rounded-2xl border border-adaptive space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff]">Acoustic Valence-Arousal Analysis</span>
          <h4 class="font-semibold text-lg text-ink">Track Emotional & Energy Profile</h4>
        </div>
        <div id="mood-tags-container" class="flex gap-2 flex-wrap">
          <span class="text-xs font-semibold px-3 py-1 rounded-full bg-[#0066cc]/10 text-[#0066cc] dark:text-[#2997ff]">Awaiting Audio</span>
        </div>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Energy -->
        <div class="p-4 rounded-xl bg-canvas border border-adaptive">
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-adaptive">Energy Score</span>
            <span class="text-xs font-mono text-[#0066cc] dark:text-[#2997ff] font-bold" id="energy-badge">--/100</span>
          </div>
          <div class="text-2xl font-bold text-ink mt-1" id="energy-val">--</div>
          <div class="w-full bg-parchment h-2 rounded-full mt-2 border border-adaptive">
            <div id="energy-bar" class="bg-[#0066cc] dark:bg-[#2997ff] h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <!-- Danceability -->
        <div class="p-4 rounded-xl bg-canvas border border-adaptive">
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-adaptive">Danceability</span>
            <span class="text-xs font-mono text-[#0066cc] dark:text-[#2997ff] font-bold" id="dance-badge">--/100</span>
          </div>
          <div class="text-2xl font-bold text-ink mt-1" id="dance-val">--</div>
          <div class="w-full bg-parchment h-2 rounded-full mt-2 border border-adaptive">
            <div id="dance-bar" class="bg-[#0066cc] dark:bg-[#2997ff] h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <!-- Valence (Positivity) -->
        <div class="p-4 rounded-xl bg-canvas border border-adaptive">
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-adaptive">Valence (Positivity)</span>
            <span class="text-xs font-mono text-[#0066cc] dark:text-[#2997ff] font-bold" id="valence-badge">--/100</span>
          </div>
          <div class="text-2xl font-bold text-ink mt-1" id="valence-val">--</div>
          <div class="w-full bg-parchment h-2 rounded-full mt-2 border border-adaptive">
            <div id="valence-bar" class="bg-[#0066cc] dark:bg-[#2997ff] h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <!-- Brightness / Timbre -->
        <div class="p-4 rounded-xl bg-canvas border border-adaptive">
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-adaptive">Spectral Brightness</span>
            <span class="text-xs font-mono text-[#0066cc] dark:text-[#2997ff] font-bold" id="bright-badge">--/100</span>
          </div>
          <div class="text-2xl font-bold text-ink mt-1" id="bright-val">--</div>
          <div class="w-full bg-parchment h-2 rounded-full mt-2 border border-adaptive">
            <div id="bright-bar" class="bg-[#0066cc] dark:bg-[#2997ff] h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>
      </div>
    </div>
  </InteractiveAudioTool>

  <script>
    import { analyzeMoodFromBuffer, downloadBlob } from '../../utils/audioEngine';

    function setupMoodDetector() {
      const energyVal = document.getElementById('energy-val');
      const energyBar = document.getElementById('energy-bar');
      const energyBadge = document.getElementById('energy-badge');

      const danceVal = document.getElementById('dance-val');
      const danceBar = document.getElementById('dance-bar');
      const danceBadge = document.getElementById('dance-badge');

      const valenceVal = document.getElementById('valence-val');
      const valenceBar = document.getElementById('valence-bar');
      const valenceBadge = document.getElementById('valence-badge');

      const brightVal = document.getElementById('bright-val');
      const brightBar = document.getElementById('bright-bar');
      const brightBadge = document.getElementById('bright-badge');

      const tagsContainer = document.getElementById('mood-tags-container');

      let lastResult: any = null;

      window.addEventListener('audio-loaded', ((e: CustomEvent) => {
        const { buffer, filename } = e.detail;
        if (!buffer) return;

        const result = analyzeMoodFromBuffer(buffer);
        lastResult = { ...result, filename };

        if (energyVal) energyVal.textContent = `${result.energy} / 100`;
        if (energyBar) energyBar.style.width = `${result.energy}%`;
        if (energyBadge) energyBadge.textContent = `${result.energy}%`;

        if (danceVal) danceVal.textContent = `${result.danceability} / 100`;
        if (danceBar) danceBar.style.width = `${result.danceability}%`;
        if (danceBadge) danceBadge.textContent = `${result.danceability}%`;

        if (valenceVal) valenceVal.textContent = `${result.valence} / 100`;
        if (valenceBar) valenceBar.style.width = `${result.valence}%`;
        if (valenceBadge) valenceBadge.textContent = `${result.valence}%`;

        if (brightVal) brightVal.textContent = `${result.brightness} / 100`;
        if (brightBar) brightBar.style.width = `${result.brightness}%`;
        if (brightBadge) brightBadge.textContent = `${result.brightness}%`;

        if (tagsContainer) {
          tagsContainer.innerHTML = '';
          result.moodTags.forEach(tag => {
            const span = document.createElement('span');
            span.className = 'text-xs font-semibold px-3 py-1 rounded-full bg-[#0066cc]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20';
            span.textContent = tag;
            tagsContainer.appendChild(span);
          });
        }
      }) as EventListener);

      window.addEventListener('audio-custom-download', ((e: CustomEvent) => {
        if (!lastResult) return;
        e.preventDefault();
        const jsonBlob = new Blob([JSON.stringify(lastResult, null, 2)], { type: 'application/json' });
        downloadBlob(jsonBlob, `${lastResult.filename || 'track'}_mood_analysis.json`);
      }) as EventListener);
    }

    setupMoodDetector();
    document.addEventListener('astro:page-load', setupMoodDetector);
  </script>
</Layout>
