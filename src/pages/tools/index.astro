---
// src/pages/tools/index.astro
import Layout from '../../layouts/Layout.astro';

const tools = [
  { name: "Media Converter", slug: "media-converter", icon: "🎵", category: "Conversion", desc: "Convert audio and video files between formats directly in your browser. MP3, WAV, OGG, FLAC, AAC, MP4, WebM." },
  { name: "Audio to MIDI & Piano Roll", slug: "audio-to-midi", icon: "🎹", category: "Conversion", desc: "Convert vocal melodies, instrumental lines, or full tracks into editable MIDI files with interactive 88-key piano roll." },
  { name: "10-Band Parametric Equalizer", slug: "equalizer", icon: "🎚️", category: "Enhancement", desc: "Shape frequency curves with live spectrum analysis. Cut bass rumble, boost crisp highs, or sculpt vocals." },
  { name: "Audio & Lyrics Transcriber", slug: "audio-transcriber", icon: "🎤", category: "Analysis", desc: "AI speech-to-text transcriber that generates timestamped lyrics, SRT, VTT, and LRC subtitle files." },
  { name: "AI Stem Splitter", slug: "stem-splitter", icon: "🎼", category: "Separation", desc: "Isolate vocals, drums, bass, and instrumental backing stems from any song track." },
  { name: "DAW Multi-Track Audio Merger", slug: "audio-merger", icon: "🎛️", category: "Editing", desc: "Mix and layer multiple audio clips on a timeline. Adjust volume, pan, and export final stereo mix." },
  { name: "Precision Audio Trimmer", slug: "audio-trimmer", icon: "✂️", category: "Editing", desc: "Cut and crop audio files visually. Drag start/end markers on the waveform canvas with millisecond accuracy." },
  { name: "BPM & Tap Tempo Detector", slug: "bpm-detector", icon: "🥁", category: "Analysis", desc: "Instantly detect song tempo in BPM or tap manually along to find the rhythm speed." },
  { name: "Musical Key & Scale Detector", slug: "key-detector", icon: "🔑", category: "Analysis", desc: "Detect musical key, scale, and Camelot wheel code for DJ harmonic mixing and song arrangement." },
  { name: "AI Track Mood & Vibe Analyzer", slug: "mood-detector", icon: "⚡", category: "Analysis", desc: "Extract valence, danceability, energy scores, and emotional mood tags using AI audio analysis." },
  { name: "AI Noise & Hum Remover", slug: "noise-remover", icon: "🔇", category: "Enhancement", desc: "Clean up noisy voice notes, podcasts, and recordings by suppressing hum, wind, and hiss." },
  { name: "AI Reverb & Echo Remover", slug: "reverb-remover", icon: "🏛️", category: "Enhancement", desc: "Remove room echo and reverberation from un-treated vocal recordings." },
  { name: "Speed & Pitch Shifter", slug: "speed-pitch-changer", icon: "⏩", category: "Editing", desc: "Real-time tempo transposing and pitch shifting for Nightcore, Sped Up, or Slowed & Reverb tracks." }
];
---

<Layout title="Free Audio Tools Gallery - Music Finder AI" subnavTitle="Audio Tools (13)" activeTool="Directory">
  <div class="py-16 px-4 md:px-8 bg-parchment border-b border-adaptive">
    <div class="max-w-[1200px] mx-auto text-center">
      <span class="text-[#0066cc] dark:text-[#2997ff] font-semibold text-xs uppercase tracking-wider block mb-2">WebAudio DAW Studio</span>
      <h1 class="font-display font-semibold text-4xl md:text-5xl text-ink tracking-tight mb-4">
        13 Browser Audio Tools
      </h1>
      <p class="text-lg md:text-xl text-muted-adaptive max-w-2xl mx-auto">
        Free browser-based audio production and analysis tools. No sign-up, no downloads, complete privacy.
      </p>

      <!-- Category Filter Pills — functional: clicking filters the tool grid -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-8" id="filter-pills">
        <button data-filter="all" class="filter-pill px-4 py-1.5 rounded-full bg-[#0066cc] text-white text-xs font-medium cursor-pointer transition-all">
          All Tools (13)
        </button>
        <button data-filter="Analysis" class="filter-pill px-4 py-1.5 rounded-full bg-surface-card text-ink hover:bg-canvas text-xs font-medium border border-adaptive cursor-pointer transition-all">
          Analysis
        </button>
        <button data-filter="Enhancement" class="filter-pill px-4 py-1.5 rounded-full bg-surface-card text-ink hover:bg-canvas text-xs font-medium border border-adaptive cursor-pointer transition-all">
          Enhancement
        </button>
        <button data-filter="Editing" class="filter-pill px-4 py-1.5 rounded-full bg-surface-card text-ink hover:bg-canvas text-xs font-medium border border-adaptive cursor-pointer transition-all">
          Editing & Conversion
        </button>
      </div>
    </div>
  </div>

  <div class="py-16 px-4 md:px-8 bg-canvas">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="tools-grid">
        {tools.map((t) => (
          <!-- data-category enables JS filtering -->
          <div
            data-category={t.category}
            class="tool-card bg-surface-card rounded-[20px] p-8 border border-adaptive hover:border-[#0066cc] dark:hover:border-[#2997ff] hover:shadow-lg transition-all flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="w-12 h-12 rounded-2xl bg-canvas border border-adaptive flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                  {t.icon}
                </span>
                <span class="text-xs font-medium text-[#0066cc] dark:text-[#2997ff] bg-[#0066cc]/10 px-3 py-1 rounded-full">
                  {t.category || "Audio Tool"}
                </span>
              </div>
              <h2 class="font-display font-semibold text-2xl text-ink mb-3 group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
                {t.name}
              </h2>
              <p class="text-sm text-muted-adaptive leading-relaxed">
                {t.desc}
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-adaptive flex items-center justify-between">
              <span class="text-xs text-muted-adaptive">WebAudio API</span>
              <a href={`/tools/${t.slug}`} class="btn-action-primary !py-2 !px-5 !text-xs no-underline">
                Open Studio →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    // Category filter functionality
    function setupFilter() {
      const pills    = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
      const cards    = document.querySelectorAll<HTMLElement>('.tool-card');

      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          const filter = pill.dataset.filter || 'all';

          // Update pill active states
          pills.forEach(p => {
            const isActive = p === pill;
            p.classList.toggle('bg-[#0066cc]', isActive);
            p.classList.toggle('text-white', isActive);
            p.classList.toggle('bg-surface-card', !isActive);
            p.classList.toggle('text-ink', !isActive);
            p.classList.toggle('border', !isActive);
            p.classList.toggle('border-adaptive', !isActive);
          });

          // Show/hide cards
          cards.forEach(card => {
            const cat = card.dataset.category || '';
            const show = filter === 'all' || cat === filter || (filter === 'Editing' && (cat === 'Editing' || cat === 'Conversion'));
            card.style.display = show ? '' : 'none';
          });
        });
      });
    }

    setupFilter();
    document.addEventListener('astro:page-load', setupFilter);
  </script>
</Layout>
