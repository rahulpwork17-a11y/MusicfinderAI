---
// src/pages/tools/bpm-detector.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'analysis-window', label: 'BPM Analysis Accuracy', type: 'select' as const, default: 'Full Track Average', options: ['Full Track Average', '10-Second Peak Window', 'High-Speed Transient Mode'] },
];
---

<Layout title="BPM & Tap Tempo Detector - Music Finder AI" subnavTitle="BPM Detector" activeTool="BPM">
  <InteractiveAudioTool
    toolName="BPM & Tap Tempo Counter"
    toolDescription="Detect exact beats-per-minute (BPM) from any audio file with autocorrelation analysis or tap along manually in real-time."
    icon="🥁"
    badge="Rhythm Analysis"
    controls={controls}
    exportFormats={["CSV BPM Report", "JSON Specs", "Text Report"]}
    showSlotInitially={true}
  >
    <!-- Detected BPM / Track Rhythm Card (Active when audio is loaded) -->
    <div id="detected-bpm-card" class="hidden mt-6 bg-surface-card p-6 md:p-8 rounded-2xl border border-adaptive space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff]">Autocorrelation Rhythm Analysis</span>
          <h3 class="text-xl font-bold text-ink mt-0.5">Detected Track Tempo</h3>
        </div>
        <div class="flex items-center gap-2">
          <span id="bpm-metronome-light" class="w-3.5 h-3.5 rounded-full bg-neutral-300 dark:bg-neutral-700 transition-all duration-75"></span>
          <span class="text-xs font-medium text-muted-adaptive">Metronome Pulse</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        <!-- Big BPM display -->
        <div class="p-6 rounded-2xl bg-canvas border border-adaptive text-center">
          <span class="text-xs font-medium text-muted-adaptive uppercase tracking-wider">Estimated Tempo</span>
          <div class="text-6xl font-display font-extrabold text-[#0066cc] dark:text-[#2997ff] my-2 tracking-tight" id="detected-bpm-value">
            ---
          </div>
          <span class="text-xs font-semibold text-ink px-3 py-1 rounded-full bg-parchment border border-adaptive inline-block" id="detected-tempo-class">
            Calculating...
          </span>
        </div>

        <!-- Metric Cards -->
        <div class="space-y-3 md:col-span-2">
          <div class="p-4 rounded-xl bg-canvas border border-adaptive flex items-center justify-between">
            <div>
              <span class="text-xs text-muted-adaptive block">Detection Confidence</span>
              <span class="text-base font-bold text-ink" id="detected-confidence">--%</span>
            </div>
            <div class="w-32 bg-parchment h-2 rounded-full border border-adaptive">
              <div id="confidence-bar" class="bg-[#0066cc] dark:bg-[#2997ff] h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 rounded-xl bg-canvas border border-adaptive">
              <span class="text-xs text-muted-adaptive block">Half-Time Tempo</span>
              <span class="text-base font-bold text-ink font-mono" id="halftime-bpm">-- BPM</span>
            </div>
            <div class="p-4 rounded-xl bg-canvas border border-adaptive">
              <span class="text-xs text-muted-adaptive block">Double-Time Tempo</span>
              <span class="text-base font-bold text-ink font-mono" id="doubletime-bpm">-- BPM</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tap Tempo Tapper Box -->
    <div class="mt-6 bg-canvas p-8 rounded-2xl border border-adaptive text-center space-y-4 shadow-sm">
      <div class="flex items-center justify-between max-w-md mx-auto">
        <h4 class="font-semibold text-lg text-ink">Manual Tap-Tempo Counter</h4>
        <button id="reset-tap-btn" class="text-xs text-muted-adaptive hover:text-ink underline cursor-pointer">
          Reset Counter
        </button>
      </div>
      <p class="text-xs text-muted-adaptive">Tap the button or press spacebar in rhythm with the beat</p>
      
      <div class="text-6xl font-display font-extrabold text-[#0066cc] dark:text-[#2997ff]" id="tap-bpm-value">
        120 <span class="text-base font-normal text-muted-adaptive">BPM</span>
      </div>

      <div class="flex items-center justify-center gap-3">
        <button id="tap-btn" class="btn-action-primary !py-4 !px-12 !text-lg shadow-md cursor-pointer select-none active:scale-95 transition-transform">
          🥁 TAP HERE TO COUNT BPM
        </button>
      </div>
      <p class="text-[11px] text-muted-adaptive font-mono" id="tap-count-text">Taps recorded: 0</p>
    </div>
  </InteractiveAudioTool>

  <script>
    import { detectBpmFromBuffer, downloadBlob } from '../../utils/audioEngine';

    function setupBpmDetector() {
      let taps: number[] = [];
      const tapBtn = document.getElementById('tap-btn');
      const resetTapBtn = document.getElementById('reset-tap-btn');
      const tapBpmVal = document.getElementById('tap-bpm-value');
      const tapCountText = document.getElementById('tap-count-text');

      const detectedCard = document.getElementById('detected-bpm-card');
      const detectedBpmVal = document.getElementById('detected-bpm-value');
      const detectedTempoClass = document.getElementById('detected-tempo-class');
      const detectedConfidence = document.getElementById('detected-confidence');
      const confidenceBar = document.getElementById('confidence-bar');
      const halftimeBpm = document.getElementById('halftime-bpm');
      const doubletimeBpm = document.getElementById('doubletime-bpm');
      const metronomeLight = document.getElementById('bpm-metronome-light');

      let metronomeInterval: any = null;
      let lastResult: any = null;

      // Handle Manual Tap
      function handleTap() {
        const now = Date.now();
        // Reset if pause was greater than 2.5 seconds
        if (taps.length > 0 && now - taps[taps.length - 1] > 2500) {
          taps = [];
        }
        taps.push(now);
        if (taps.length > 16) taps.shift();

        if (tapCountText) tapCountText.textContent = `Taps recorded: ${taps.length}`;

        if (taps.length > 1) {
          const intervals = [];
          for (let i = 1; i < taps.length; i++) {
            intervals.push(taps[i] - taps[i - 1]);
          }
          const avgInterval = intervals.reduce((a, b) => a + b, 0) / intervals.length;
          const bpm = Math.round(60000 / avgInterval);
          if (tapBpmVal) tapBpmVal.innerHTML = `${bpm} <span class="text-base font-normal text-muted-adaptive">BPM</span>`;
        }
      }

      tapBtn?.addEventListener('click', handleTap);
      resetTapBtn?.addEventListener('click', () => {
        taps = [];
        if (tapBpmVal) tapBpmVal.innerHTML = `--- <span class="text-base font-normal text-muted-adaptive">BPM</span>`;
        if (tapCountText) tapCountText.textContent = `Taps recorded: 0`;
      });

      const handleKeyDown = (e: KeyboardEvent) => {
        if (e.code === 'Space') {
          const active = document.activeElement;
          if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT')) {
            return;
          }
          e.preventDefault();
          handleTap();
        }
      };

      window.addEventListener('keydown', handleKeyDown);

      // Handle Audio Upload Event
      window.addEventListener('audio-loaded', ((e: CustomEvent) => {
        const { buffer, filename } = e.detail;
        if (!buffer) return;

        const result = detectBpmFromBuffer(buffer);
        lastResult = { ...result, filename };

        if (detectedCard) detectedCard.classList.remove('hidden');
        if (detectedBpmVal) detectedBpmVal.textContent = String(result.bpm);
        if (detectedConfidence) detectedConfidence.textContent = `${result.confidence}%`;
        if (confidenceBar) confidenceBar.style.width = `${result.confidence}%`;
        if (halftimeBpm) halftimeBpm.textContent = `${Math.round(result.bpm / 2)} BPM`;
        if (doubletimeBpm) doubletimeBpm.textContent = `${result.bpm * 2} BPM`;

        // Classification
        let tempoName = 'Moderato';
        if (result.bpm < 80) tempoName = 'Adagio / Slow Beat';
        else if (result.bpm < 108) tempoName = 'Andante / Hip-Hop & R&B';
        else if (result.bpm < 128) tempoName = 'House / Pop / Dance';
        else if (result.bpm < 150) tempoName = 'Techno / Trance / Trap';
        else tempoName = 'Presto / Drum & Bass / Hardcore';

        if (detectedTempoClass) detectedTempoClass.textContent = tempoName;

        // Metronome Pulse
        if (metronomeInterval) clearInterval(metronomeInterval);
        const intervalMs = (60 / result.bpm) * 1000;
        metronomeInterval = setInterval(() => {
          if (metronomeLight) {
            metronomeLight.classList.add('bg-[#0066cc]', 'scale-125', 'shadow-md');
            metronomeLight.classList.remove('bg-neutral-300', 'dark:bg-neutral-700');
            setTimeout(() => {
              metronomeLight.classList.remove('bg-[#0066cc]', 'scale-125', 'shadow-md');
              metronomeLight.classList.add('bg-neutral-300', 'dark:bg-neutral-700');
            }, 80);
          }
        }, intervalMs);
      }) as EventListener);

      // Handle Custom Download
      window.addEventListener('audio-custom-download', ((e: CustomEvent) => {
        if (!lastResult) return;
        e.preventDefault();
        const { format } = e.detail;

        if (format.includes('JSON')) {
          const jsonBlob = new Blob([JSON.stringify(lastResult, null, 2)], { type: 'application/json' });
          downloadBlob(jsonBlob, `${lastResult.filename || 'track'}_bpm_report.json`);
        } else {
          // CSV / Text
          const csv = `Filename,BPM,Confidence,HalfTime,DoubleTime,DurationSeconds\n"${lastResult.filename}",${lastResult.bpm},${lastResult.confidence}%,${Math.round(lastResult.bpm/2)},${lastResult.bpm*2},${lastResult.duration}\n`;
          const csvBlob = new Blob([csv], { type: 'text/csv' });
          downloadBlob(csvBlob, `${lastResult.filename || 'track'}_bpm_report.csv`);
        }
      }) as EventListener);

      window.addEventListener('audio-reset', () => {
        if (metronomeInterval) clearInterval(metronomeInterval);
        if (detectedCard) detectedCard.classList.add('hidden');
        lastResult = null;
      });
    }

    setupBpmDetector();
    document.addEventListener('astro:page-load', setupBpmDetector);
  </script>
</Layout>
