---
// src/pages/tools/bpm-detector.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'analysis-window', label: 'BPM Analysis Accuracy', type: 'select' as const, default: 'Full Track Average', options: ['Full Track Average', '10-Second Peak Window', 'Live Mic Continuous'] },
];
---

<Layout title="BPM & Tap Tempo Detector - Music Finder AI" subnavTitle="BPM Detector" activeTool="BPM">
  <InteractiveAudioTool
    toolName="BPM & Tap Tempo Counter"
    toolDescription="Detect exact beats-per-minute (BPM) from any audio file or tap along manually in real-time."
    icon="🥁"
    badge="Rhythm Analysis"
    controls={controls}
    exportFormats={["CSV BPM Report", "JSON Specs"]}
    showSlotInitially={true}
  >
    <!-- Tap Tempo Tapper Box -->
    <div class="mt-6 bg-canvas p-8 rounded-2xl border border-adaptive text-center space-y-4 shadow-sm">
      <h4 class="font-semibold text-lg text-ink">Manual Tap-Tempo Counter</h4>
      <p class="text-xs text-muted-adaptive">Tap the button or press spacebar in rhythm with the music</p>
      
      <div class="text-5xl font-display font-bold text-[#0066cc] dark:text-[#2997ff]" id="tap-bpm-value">
        124 <span class="text-base font-normal text-muted-adaptive">BPM</span>
      </div>

      <button id="tap-btn" class="btn-action-primary !py-4 !px-12 !text-lg shadow-md cursor-pointer select-none">
        🥁 TAP HERE TO COUNT BPM
      </button>
    </div>
  </InteractiveAudioTool>

  <script>
    function setupBpmTap() {
      let taps: number[] = [];
      const tapBtn = document.getElementById('tap-btn');
      const bpmVal = document.getElementById('tap-bpm-value');

      function handleTap() {
        const now = Date.now();
        taps.push(now);
        if (taps.length > 8) taps.shift();

        if (taps.length > 1) {
          const intervals = [];
          for (let i = 1; i < taps.length; i++) {
            intervals.push(taps[i] - taps[i - 1]);
          }
          const avgInterval = intervals.reduce((a, b) => a + b, 0) / intervals.length;
          const bpm = Math.round(60000 / avgInterval);
          if (bpmVal) bpmVal.innerHTML = `${bpm} <span class="text-base font-normal text-muted-adaptive">BPM</span>`;
        }
      }

      tapBtn?.addEventListener('click', handleTap);

      const handleKeyDown = (e: KeyboardEvent) => {
        if (e.code === 'Space') {
          const active = document.activeElement;
          if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT')) {
            return;
          }
          e.preventDefault();
          tapBtn?.focus();
          handleTap();
        }
      };

      window.addEventListener('keydown', handleKeyDown);
    }
    setupBpmTap();
    document.addEventListener('astro:page-load', setupBpmTap);
  </script>
</Layout>
