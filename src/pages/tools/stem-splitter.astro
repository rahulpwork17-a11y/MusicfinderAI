---
// src/pages/tools/stem-splitter.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'stems-count', label: 'Stem Separation Mode', type: 'select' as const, default: '4 Stems (Vocals, Drums, Bass, Other)', options: ['2 Stems (Vocals + Instrumental)', '4 Stems (Vocals, Drums, Bass, Other)', '5 Stems (+ Piano)'] },
  { id: 'quality', label: 'Separation Quality', type: 'select' as const, default: 'High Fidelity AI', options: ['High Fidelity AI', 'Ultra Detail (Slower)'] },
];
---

<Layout title="AI Stem Splitter - Music Finder AI" subnavTitle="AI Stem Splitter" activeTool="Stems">
  <InteractiveAudioTool
    toolName="AI Vocal & Instrument Stem Splitter"
    toolDescription="Isolate or remove vocals, drums, basslines, and backing instrumentals from any song for sampling, practice, or remixing."
    icon="🎼"
    badge="AI Stem Separator"
    controls={controls}
    exportFormats={["ZIP All Stems", "Vocals WAV", "Instrumental WAV", "Drums WAV"]}
  >
    <!-- 4 Stem Mixer Sliders -->
    <div class="mt-6 bg-white p-6 rounded-2xl border border-[#e0e0e0] space-y-4">
      <h4 class="font-semibold text-sm text-[#1d1d1f]">Live Stem Mixer & Solo / Mute Toggles</h4>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { name: "🎤 Vocals", color: "from-blue-500 to-indigo-500" },
          { name: "🥁 Drums", color: "from-purple-500 to-pink-500" },
          { name: "🎸 Bass", color: "from-amber-500 to-orange-500" },
          { name: "🎹 Other / Synth", color: "from-emerald-500 to-teal-500" }
        ].map((stem) => (
          <div class="p-4 rounded-xl bg-[#fafafc] border border-[#e0e0e0] space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-sm text-[#1d1d1f]">{stem.name}</span>
              <span class="text-xs text-[#0066cc] font-mono font-bold">100%</span>
            </div>
            
            <input type="range" min="0" max="100" value="100" class="w-full accent-[#0066cc]" />
            
            <div class="flex gap-2 text-xs">
              <button class="flex-1 py-1 rounded bg-white hover:bg-neutral-200 border border-[#e0e0e0] font-medium text-[#1d1d1f]">
                Solo
              </button>
              <button class="flex-1 py-1 rounded bg-white hover:bg-neutral-200 border border-[#e0e0e0] font-medium text-[#1d1d1f]">
                Mute
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </InteractiveAudioTool>
</Layout>
