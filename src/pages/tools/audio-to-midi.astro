---
// src/pages/tools/audio-to-midi.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'midi-mode', label: 'Polyphonic Transcription Mode', type: 'select' as const, default: 'Full Polyphonic Mix', options: ['Full Polyphonic Mix', 'Monophonic Melody Lead', 'Bassline Isolation', 'Percussion / Drum Notes'] },
  { id: 'sensitivity', label: 'Pitch Detection Sensitivity', type: 'slider' as const, min: 10, max: 100, step: 5, default: 75, unit: '%' },
  { id: 'pitch-quantize', label: 'Note Quantization', type: 'select' as const, default: '1/16 Note', options: ['None (Free Form)', '1/8 Note', '1/16 Note', '1/32 Note'] },
];
---

<Layout title="Audio to MIDI Converter & Piano Roll - Music Finder AI" subnavTitle="Audio to MIDI" activeTool="MIDI">
  <InteractiveAudioTool
    toolName="Audio to MIDI & Piano Roll Visualizer"
    toolDescription="Turn vocal melodies, instrument solos, or full tracks into editable MIDI files with an interactive 88-key piano roll."
    icon="🎹"
    badge="AI Polyphonic Transcription"
    controls={controls}
    exportFormats={["MIDI (.mid)", "JSON Note Map", "WAV Render"]}
  >
    <!-- Interactive 88-Key Piano Roll Visualizer Slot -->
    <div class="mt-6 bg-[#1d1d1f] p-6 md:p-8 rounded-2xl border border-neutral-800 text-white space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
        <h4 class="font-semibold text-sm flex items-center gap-2">
          <span>🎹 Interactive Piano Roll Preview</span>
          <span class="text-xs text-[#2997ff] font-mono" id="piano-roll-range">C2 - C6 (Octaves)</span>
        </h4>
        <div class="flex items-center gap-3 text-xs">
          <span class="text-neutral-400 font-mono" id="notes-count-badge">0 Notes Detected</span>
          <button id="preview-synth-btn" class="px-3 py-1.5 rounded-lg bg-[#0066cc] text-white hover:bg-[#0077ed] font-medium transition-colors flex items-center gap-1">
            <span>🔊</span>
            <span id="synth-btn-text">Play MIDI Synth</span>
          </button>
        </div>
      </div>

      <!-- Piano Roll Canvas Grid Visual -->
      <div class="h-48 bg-black/70 rounded-xl border border-neutral-800 p-2 overflow-x-auto relative" id="piano-roll-container">
        <canvas id="piano-roll-canvas" class="w-full h-full block rounded"></canvas>
      </div>

      <div class="flex items-center justify-between text-xs text-neutral-400">
        <span>Drag & scroll to inspect notes</span>
        <span class="text-[#2997ff] font-mono">Export format: Standard MIDI 1.0 (.mid)</span>
      </div>
    </div>
  </InteractiveAudioTool>

  <script>
    import { detectMidiNotesFromBuffer, generateMidiFileBlob, downloadBlob, type MidiNote } from '../../utils/audioEngine';

    function setupMidiConverter() {
      const prCanvas = document.getElementById('piano-roll-canvas') as HTMLCanvasElement;
      const notesCountBadge = document.getElementById('notes-count-badge');
      const synthBtn = document.getElementById('preview-synth-btn');
      const synthText = document.getElementById('synth-btn-text');
      const sensitivityInput = document.getElementById('sensitivity') as HTMLInputElement;

      let detectedNotes: MidiNote[] = [];
      let currentFileName = 'track';
      let synthAudioCtx: AudioContext | null = null;
      let isSynthPlaying = false;
      let synthTimeouts: any[] = [];

      function drawPianoRoll(notes: MidiNote[]) {
        if (!prCanvas) return;
        const ctx = prCanvas.getContext('2d');
        if (!ctx) return;

        prCanvas.width = prCanvas.parentElement?.clientWidth || 800;
        prCanvas.height = 180;

        ctx.clearRect(0, 0, prCanvas.width, prCanvas.height);

        if (notes.length === 0) {
          ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
          ctx.font = '13px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Upload audio to extract notes into the piano roll', prCanvas.width / 2, prCanvas.height / 2);
          return;
        }

        const minNote = Math.min(...notes.map(n => n.note), 36);
        const maxNote = Math.max(...notes.map(n => n.note), 84);
        const noteRange = Math.max(12, maxNote - minNote + 1);

        const maxTime = Math.max(...notes.map(n => n.time + n.duration), 10);
        const timeScale = prCanvas.width / maxTime;

        // Draw horizontal pitch grid lines
        for (let n = 0; n < noteRange; n++) {
          const y = (n / noteRange) * prCanvas.height;
          ctx.fillStyle = n % 2 === 0 ? 'rgba(255, 255, 255, 0.03)' : 'transparent';
          ctx.fillRect(0, y, prCanvas.width, prCanvas.height / noteRange);
        }

        // Draw note blocks
        notes.forEach(n => {
          const x = n.time * timeScale;
          const w = Math.max(4, n.duration * timeScale);
          const y = prCanvas.height - ((n.note - minNote + 1) / noteRange) * prCanvas.height;
          const h = Math.max(4, prCanvas.height / noteRange - 1);

          ctx.fillStyle = '#2997ff';
          ctx.beginPath();
          ctx.roundRect(x, y, w, h, 2);
          ctx.fill();

          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 0.5;
          ctx.stroke();
        });
      }

      drawPianoRoll([]);

      window.addEventListener('audio-loaded', ((e: CustomEvent) => {
        const { buffer, filename } = e.detail;
        if (!buffer) return;

        currentFileName = filename || 'track';
        const sens = parseInt(sensitivityInput?.value || '75', 10);
        detectedNotes = detectMidiNotesFromBuffer(buffer, sens);

        if (notesCountBadge) notesCountBadge.textContent = `${detectedNotes.length} Notes Detected`;
        drawPianoRoll(detectedNotes);
      }) as EventListener);

      // Play Synthesizer Preview of MIDI notes
      synthBtn?.addEventListener('click', () => {
        if (isSynthPlaying) {
          stopSynth();
          return;
        }
        if (detectedNotes.length === 0) return;

        playSynth();
      });

      function playSynth() {
        synthAudioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        isSynthPlaying = true;
        if (synthText) synthText.textContent = 'Stop Synth';

        synthTimeouts = [];

        detectedNotes.forEach(n => {
          const tId = setTimeout(() => {
            if (!synthAudioCtx || !isSynthPlaying) return;
            const osc = synthAudioCtx.createOscillator();
            const gain = synthAudioCtx.createGain();

            // MIDI to Hz: 440 * 2^((note - 69) / 12)
            const freq = 440 * Math.pow(2, (n.note - 69) / 12);
            osc.type = 'sawtooth';
            osc.frequency.value = freq;

            const startTime = synthAudioCtx.currentTime;
            gain.gain.setValueAtTime(0.2, startTime);
            gain.gain.exponentialRampToValueAtTime(0.001, startTime + Math.min(n.duration, 0.4));

            osc.connect(gain);
            gain.connect(synthAudioCtx.destination);

            osc.start(startTime);
            osc.stop(startTime + n.duration);
          }, n.time * 1000);

          synthTimeouts.push(tId);
        });
      }

      function stopSynth() {
        synthTimeouts.forEach(t => clearTimeout(t));
        synthTimeouts = [];
        if (synthAudioCtx) {
          synthAudioCtx.close();
          synthAudioCtx = null;
        }
        isSynthPlaying = false;
        if (synthText) synthText.textContent = 'Play MIDI Synth';
      }

      // Handle MIDI Download
      window.addEventListener('audio-custom-download', ((e: CustomEvent) => {
        if (detectedNotes.length === 0) return;
        e.preventDefault();

        const { format } = e.detail;
        if (format.includes('JSON')) {
          const jsonBlob = new Blob([JSON.stringify(detectedNotes, null, 2)], { type: 'application/json' });
          downloadBlob(jsonBlob, `${currentFileName.replace(/\.[^/.]+$/, "")}_notes.json`);
        } else {
          const midiBlob = generateMidiFileBlob(detectedNotes);
          downloadBlob(midiBlob, `${currentFileName.replace(/\.[^/.]+$/, "")}.mid`);
        }
      }) as EventListener);
    }

    setupMidiConverter();
    document.addEventListener('astro:page-load', setupMidiConverter);
  </script>
</Layout>
