---
// src/pages/tools/audio-trimmer.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'fade-in', label: 'Fade In Duration', type: 'slider' as const, min: 0, max: 5, step: 0.1, default: 0.5, unit: 'sec' },
  { id: 'fade-out', label: 'Fade Out Duration', type: 'slider' as const, min: 0, max: 5, step: 0.1, default: 1.0, unit: 'sec' },
  { id: 'mode', label: 'Action Mode', type: 'select' as const, default: 'Keep Selection (Crop)', options: ['Keep Selection (Crop)', 'Cut Selection (Remove)'] },
];
---

<Layout title="Precision Waveform Audio Trimmer - Music Finder AI" subnavTitle="Audio Trimmer" activeTool="Trimmer">
  <InteractiveAudioTool
    toolName="Precision Waveform Audio Trimmer & Cutter"
    toolDescription="Cut and crop audio clips visually. Set start and end markers with millisecond precision and smooth fade transitions."
    icon="✂️"
    badge="Millisecond Accuracy"
    controls={controls}
    exportFormats={["WAV (Uncompressed)", "MP3 Ready", "M4A Ringtone"]}
  >
    <!-- Trimming Range Controls Card -->
    <div id="trim-controls-card" class="mt-6 bg-surface-card p-6 md:p-8 rounded-2xl border border-adaptive space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h4 class="font-semibold text-base text-ink">Precision Trim Range Boundaries</h4>
          <p class="text-xs text-muted-adaptive">Specify exact start and end timestamps in seconds</p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-[#0066cc]/10 text-[#0066cc] dark:text-[#2997ff] font-bold" id="selection-duration-badge">
          Selection: 0.00s
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <div class="p-4 rounded-xl bg-canvas border border-adaptive space-y-2">
          <label for="trim-start-input" class="text-xs font-semibold text-ink block">Start Time (sec)</label>
          <div class="flex items-center gap-2">
            <input
              type="number"
              id="trim-start-input"
              min="0"
              step="0.1"
              value="0.0"
              class="w-full px-3 py-2 rounded-lg border border-adaptive bg-surface-card text-ink font-mono text-sm focus:outline-none focus:border-[#0066cc]"
            />
            <button id="set-current-start-btn" class="px-2.5 py-2 rounded-lg border border-adaptive text-xs hover:bg-canvas font-medium whitespace-nowrap">
              Mark Start
            </button>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-canvas border border-adaptive space-y-2">
          <label for="trim-end-input" class="text-xs font-semibold text-ink block">End Time (sec)</label>
          <div class="flex items-center gap-2">
            <input
              type="number"
              id="trim-end-input"
              min="0"
              step="0.1"
              value="30.0"
              class="w-full px-3 py-2 rounded-lg border border-adaptive bg-surface-card text-ink font-mono text-sm focus:outline-none focus:border-[#0066cc]"
            />
            <button id="set-current-end-btn" class="px-2.5 py-2 rounded-lg border border-adaptive text-xs hover:bg-canvas font-medium whitespace-nowrap">
              Mark End
            </button>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-canvas border border-adaptive flex flex-col justify-center gap-2">
          <span class="text-xs text-muted-adaptive">Quick Length Presets</span>
          <div class="flex gap-1.5 flex-wrap">
            <button data-dur="15" class="quick-trim-btn px-2.5 py-1 rounded bg-surface-card border border-adaptive text-xs font-medium text-ink hover:border-[#0066cc]">15s Clip</button>
            <button data-dur="30" class="quick-trim-btn px-2.5 py-1 rounded bg-surface-card border border-adaptive text-xs font-medium text-ink hover:border-[#0066cc]">30s Story</button>
            <button data-dur="60" class="quick-trim-btn px-2.5 py-1 rounded bg-surface-card border border-adaptive text-xs font-medium text-ink hover:border-[#0066cc]">60s Reel</button>
          </div>
        </div>
      </div>
    </div>
  </InteractiveAudioTool>

  <script>
    import { renderTrimBuffer, audioBufferToWav, downloadBlob } from '../../utils/audioEngine';

    function setupTrimmer() {
      const startInput = document.getElementById('trim-start-input') as HTMLInputElement;
      const endInput = document.getElementById('trim-end-input') as HTMLInputElement;
      const durationBadge = document.getElementById('selection-duration-badge');
      const fadeInInput = document.getElementById('fade-in') as HTMLInputElement;
      const fadeOutInput = document.getElementById('fade-out') as HTMLInputElement;
      const modeSelect = document.getElementById('mode') as HTMLSelectElement;
      const quickBtns = document.querySelectorAll('.quick-trim-btn');

      let currentAudioBuffer: AudioBuffer | null = null;
      let currentFileName = 'audio';

      function updateDuration() {
        if (!startInput || !endInput) return;
        const start = parseFloat(startInput.value) || 0;
        const end = parseFloat(endInput.value) || 0;
        const diff = Math.max(0, end - start);
        if (durationBadge) durationBadge.textContent = `Selection: ${diff.toFixed(2)}s`;
      }

      startInput?.addEventListener('input', updateDuration);
      endInput?.addEventListener('input', updateDuration);

      quickBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const dur = parseFloat((btn as HTMLElement).dataset.dur || '15');
          const start = parseFloat(startInput?.value || '0');
          if (endInput && currentAudioBuffer) {
            endInput.value = String(Math.min(currentAudioBuffer.duration, start + dur));
            updateDuration();
          }
        });
      });

      window.addEventListener('audio-loaded', ((e: CustomEvent) => {
        currentAudioBuffer = e.detail.buffer;
        currentFileName = e.detail.filename || 'track';

        if (startInput) startInput.value = '0.0';
        if (endInput) endInput.value = (currentAudioBuffer?.duration || 30).toFixed(2);
        updateDuration();
      }) as EventListener);

      window.addEventListener('audio-custom-download', ((e: CustomEvent) => {
        if (!currentAudioBuffer) return;
        e.preventDefault();

        const start = parseFloat(startInput?.value || '0');
        const end = parseFloat(endInput?.value || String(currentAudioBuffer.duration));
        const fadeIn = parseFloat(fadeInInput?.value || '0');
        const fadeOut = parseFloat(fadeOutInput?.value || '0');
        const mode = modeSelect?.value.includes('Cut') ? 'cut' : 'keep';

        const trimmed = renderTrimBuffer(currentAudioBuffer, start, end, fadeIn, fadeOut, mode);
        const wavBlob = audioBufferToWav(trimmed, 16);
        const outName = currentFileName.replace(/\.[^/.]+$/, "") + `_trimmed_${start.toFixed(1)}s-${end.toFixed(1)}s.wav`;
        downloadBlob(wavBlob, outName);
      }) as EventListener);
    }

    setupTrimmer();
    document.addEventListener('astro:page-load', setupTrimmer);
  </script>
</Layout>
