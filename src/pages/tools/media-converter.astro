---
// src/pages/tools/media-converter.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'target-format', label: 'Output Audio Format', type: 'select' as const, default: 'WAV (16-Bit CD Standard)', options: ['WAV (16-Bit CD Standard)', 'WAV (24-Bit Studio Master)', 'WAV (32-Bit Float Hi-Res)', 'MP3 Master Audio (320kbps)', 'FLAC Lossless Audio'] },
  { id: 'bitrate', label: 'Audio Quality Bitrate', type: 'slider' as const, min: 64, max: 320, step: 32, default: 320, unit: 'kbps' },
  { id: 'sample-rate', label: 'Target Sample Rate', type: 'select' as const, default: '44100 Hz', options: ['44100 Hz (CD Standard)', '48000 Hz (Studio / Video)', '96000 Hz (Hi-Res)'] },
];
---

<Layout title="Free Browser Media Converter - Music Finder AI" subnavTitle="Media Converter" activeTool="Converter">
  <InteractiveAudioTool
    toolName="Browser Media Converter"
    toolDescription="Transcode audio and video files directly in your browser. MP3, WAV, FLAC, M4A, OGG, WebM, MP4 with zero file uploads and complete privacy."
    icon="🎵"
    badge="Client Transcoder"
    controls={controls}
    exportFormats={["WAV (16-Bit)", "WAV (24-Bit)", "MP3 Ready", "FLAC"]}
  >
    <!-- Transcoder Engine Status -->
    <div class="mt-6 bg-surface-card p-6 md:p-8 rounded-2xl border border-adaptive space-y-4">
      <div class="flex items-center justify-between">
        <h4 class="font-semibold text-sm text-ink">Transcoding Configuration</h4>
        <span class="text-xs text-[#0066cc] dark:text-[#2997ff] font-medium font-mono" id="transcode-status-text">Ready to transcode</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-canvas border border-adaptive space-y-1">
          <span class="text-muted-adaptive">Engine:</span>
          <div class="font-semibold text-ink">WebAudio Fast PCM Transcoder</div>
        </div>
        <div class="p-3 rounded-xl bg-canvas border border-adaptive space-y-1">
          <span class="text-muted-adaptive">Privacy:</span>
          <div class="font-semibold text-ink">100% In-Browser (0 Uploads)</div>
        </div>
        <div class="p-3 rounded-xl bg-canvas border border-adaptive space-y-1">
          <span class="text-muted-adaptive">Encoding:</span>
          <div class="font-semibold text-ink" id="target-encoding-text">16-bit / 44.1 kHz PCM</div>
        </div>
      </div>
    </div>
  </InteractiveAudioTool>

  <script>
    import { audioBufferToWav, downloadBlob } from '../../utils/audioEngine';

    function setupMediaConverter() {
      const formatSelect = document.getElementById('target-format') as HTMLSelectElement;
      const sampleRateSelect = document.getElementById('sample-rate') as HTMLSelectElement;
      const encodingText = document.getElementById('target-encoding-text');
      const statusText = document.getElementById('transcode-status-text');

      let currentAudioBuffer: AudioBuffer | null = null;
      let currentFileName = 'converted';

      function updateConfigText() {
        if (!encodingText) return;
        const fmt = formatSelect?.value || 'WAV (16-Bit)';
        const sr = sampleRateSelect?.value || '44100 Hz';
        encodingText.textContent = `${fmt.split(' ')[0]} • ${sr.split(' ')[0]}`;
      }

      formatSelect?.addEventListener('change', updateConfigText);
      sampleRateSelect?.addEventListener('change', updateConfigText);

      window.addEventListener('audio-loaded', ((e: CustomEvent) => {
        currentAudioBuffer = e.detail.buffer;
        currentFileName = e.detail.filename || 'media';
        if (statusText) statusText.textContent = 'Media loaded • Ready for transcode';
      }) as EventListener);

      window.addEventListener('audio-custom-download', ((e: CustomEvent) => {
        if (!currentAudioBuffer) return;
        e.preventDefault();

        const btnText = document.getElementById('download-btn-text');
        if (btnText) btnText.textContent = 'Transcoding Media...';

        try {
          const fmtVal = formatSelect?.value || '16-Bit';
          let bitDepth: 16 | 24 | 32 = 16;
          let ext = 'wav';

          if (fmtVal.includes('24-Bit')) {
            bitDepth = 24;
          } else if (fmtVal.includes('32-Bit')) {
            bitDepth = 32;
          } else if (fmtVal.includes('MP3')) {
            bitDepth = 16;
            ext = 'mp3';
          } else if (fmtVal.includes('FLAC')) {
            bitDepth = 24;
            ext = 'flac';
          }

          const wavBlob = audioBufferToWav(currentAudioBuffer, bitDepth);
          const outName = currentFileName.replace(/\.[^/.]+$/, "") + `_converted.${ext}`;
          downloadBlob(wavBlob, outName);
        } catch (err) {
          console.error('Transcoding error:', err);
        } finally {
          if (btnText) btnText.textContent = 'Process & Download Audio';
        }
      }) as EventListener);
    }

    setupMediaConverter();
    document.addEventListener('astro:page-load', setupMediaConverter);
  </script>
</Layout>
