---
// src/pages/tools/audio-merger.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'crossfade', label: 'Crossfade Transition Duration', type: 'slider' as const, min: 0, max: 10, step: 0.5, default: 2, unit: 'sec' },
  { id: 'mode', label: 'Layering Mode', type: 'select' as const, default: 'Sequential Join', options: ['Sequential Join (Concat)', 'Multi-Track Overlay (Mixer)'] },
];
---

<Layout title="DAW Multi-Track Audio Merger - Music Finder AI" subnavTitle="Audio Merger" activeTool="Merger">
  <InteractiveAudioTool
    toolName="DAW Multi-Track Audio Merger & Timeline Mixer"
    toolDescription="Combine, crossfade, and layer multiple audio tracks on a visual timeline directly in your browser."
    icon="🎛️"
    badge="Multi-Track Studio"
    controls={controls}
    exportFormats={["MP3 Master", "WAV Stereo", "FLAC"]}
  >
    <div class="mt-6 bg-surface-card p-6 rounded-2xl border border-adaptive space-y-4">
      <h4 class="font-semibold text-sm text-ink">Timeline Track Layers</h4>
      
      <div class="space-y-3">
        <div class="p-3 rounded-xl bg-canvas border border-adaptive flex items-center justify-between">
          <span class="text-sm font-semibold text-ink">Track 1: Intro_Beat.wav (0:00 - 0:15)</span>
          <span class="text-xs text-[#0066cc] dark:text-[#2997ff]">Vol: 100%</span>
        </div>
        <div class="p-3 rounded-xl bg-canvas border border-adaptive flex items-center justify-between">
          <span class="text-sm font-semibold text-ink">Track 2: Vocal_Melody.mp3 (0:15 - 0:45)</span>
          <span class="text-xs text-[#0066cc] dark:text-[#2997ff]">Vol: 95%</span>
        </div>
      </div>
    </div>
  </InteractiveAudioTool>
</Layout>
