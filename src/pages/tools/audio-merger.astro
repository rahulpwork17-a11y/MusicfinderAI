---
// src/pages/tools/audio-merger.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'crossfade', label: 'Crossfade Transition Duration', type: 'slider' as const, min: 0, max: 8, step: 0.5, default: 2, unit: 'sec' },
  { id: 'mode', label: 'Layering Mode', type: 'select' as const, default: 'Sequential Join (Concat)', options: ['Sequential Join (Concat)', 'Multi-Track Overlay (Mixer)'] },
];
---

<Layout title="DAW Multi-Track Audio Merger - Music Finder AI" subnavTitle="Audio Merger" activeTool="Merger">
  <InteractiveAudioTool
    toolName="DAW Multi-Track Audio Merger & Timeline Mixer"
    toolDescription="Combine, crossfade, and layer multiple audio tracks on a visual timeline directly in your browser."
    icon="🎛️"
    badge="Multi-Track Studio"
    controls={controls}
    exportFormats={["WAV Stereo Master", "MP3 Mix", "FLAC Lossless"]}
    showSlotInitially={true}
  >
    <!-- Multi-Track Manager Card -->
    <div class="mt-6 bg-surface-card p-6 md:p-8 rounded-2xl border border-adaptive space-y-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h4 class="font-semibold text-base text-ink">Timeline Track Layers</h4>
          <p class="text-xs text-muted-adaptive">Add multiple audio files to stitch sequentially or mix concurrently</p>
        </div>
        <div>
          <input type="file" id="add-track-input" accept="audio/*" multiple class="hidden" />
          <button id="add-track-btn" class="btn-action-primary !py-2 !px-4 text-xs flex items-center gap-1.5 cursor-pointer">
            <span>+</span>
            <span>Add Audio Tracks</span>
          </button>
        </div>
      </div>
      
      <!-- Track List Container -->
      <div id="tracks-list-container" class="space-y-3">
        <div id="empty-tracks-msg" class="p-8 text-center bg-canvas rounded-xl border border-dashed border-adaptive text-muted-adaptive text-sm">
          No tracks loaded yet. Upload your first audio track above or click "Add Audio Tracks".
        </div>
      </div>

      <!-- Total Duration & Info -->
      <div id="merger-summary-bar" class="hidden p-4 rounded-xl bg-canvas border border-adaptive flex items-center justify-between text-xs">
        <span class="text-muted-adaptive">Total Master Duration: <strong class="text-ink font-mono" id="merger-total-dur">0:00</strong></span>
        <span class="text-[#0066cc] dark:text-[#2997ff] font-medium" id="merger-track-count">0 tracks ready to merge</span>
      </div>
    </div>
  </InteractiveAudioTool>

  <script>
    import { decodeAudioFile, renderMergedTracks, audioBufferToWav, downloadBlob, type TrackLayer } from '../../utils/audioEngine';

    function setupAudioMerger() {
      const addBtn = document.getElementById('add-track-btn');
      const addInput = document.getElementById('add-track-input') as HTMLInputElement;
      const tracksContainer = document.getElementById('tracks-list-container');
      const emptyMsg = document.getElementById('empty-tracks-msg');
      const summaryBar = document.getElementById('merger-summary-bar');
      const totalDurEl = document.getElementById('merger-total-dur');
      const trackCountEl = document.getElementById('merger-track-count');

      const crossfadeInput = document.getElementById('crossfade') as HTMLInputElement;
      const modeSelect = document.getElementById('mode') as HTMLSelectElement;

      let loadedTracks: TrackLayer[] = [];

      addBtn?.addEventListener('click', () => addInput?.click());

      addInput?.addEventListener('change', async (e: any) => {
        const files: FileList = e.target.files;
        if (!files || files.length === 0) return;

        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          try {
            const buffer = await decodeAudioFile(file);
            loadedTracks.push({
              name: file.name,
              buffer,
              volume: 1.0,
              offsetSec: 0
            });
          } catch (err) {
            console.error('Error decoding added track:', err);
          }
        }
        renderTracksList();
      });

      window.addEventListener('audio-loaded', ((e: CustomEvent) => {
        const { buffer, filename } = e.detail;
        if (!buffer) return;
        // Avoid duplicate if already top track
        if (loadedTracks.length === 0 || loadedTracks[0].name !== filename) {
          loadedTracks.push({
            name: filename,
            buffer,
            volume: 1.0,
            offsetSec: 0
          });
          renderTracksList();
        }
      }) as EventListener);

      function renderTracksList() {
        if (!tracksContainer) return;
        if (loadedTracks.length === 0) {
          if (emptyMsg) emptyMsg.classList.remove('hidden');
          if (summaryBar) summaryBar.classList.add('hidden');
          return;
        }

        if (emptyMsg) emptyMsg.classList.add('hidden');
        if (summaryBar) summaryBar.classList.remove('hidden');

        // Clear existing dynamic items except empty msg
        tracksContainer.innerHTML = '';

        let totalSec = 0;
        const isSequential = !modeSelect?.value.includes('Overlay');
        const crossfadeSec = parseFloat(crossfadeInput?.value || '0');

        loadedTracks.forEach((track, idx) => {
          const dur = track.buffer.duration;
          if (isSequential) {
            totalSec += dur - (idx > 0 ? crossfadeSec : 0);
          } else {
            totalSec = Math.max(totalSec, dur + (track.offsetSec || 0));
          }

          const m = Math.floor(dur / 60);
          const s = Math.floor(dur % 60);

          const trackCard = document.createElement('div');
          trackCard.className = 'p-4 rounded-xl bg-canvas border border-adaptive flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4';
          trackCard.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-full bg-parchment text-[#0066cc] dark:text-[#2997ff] text-xs font-bold flex items-center justify-center border border-adaptive">
                ${idx + 1}
              </span>
              <div>
                <span class="text-sm font-semibold text-ink block">${track.name}</span>
                <span class="text-xs text-muted-adaptive font-mono">${m}:${String(s).padStart(2, '0')} duration</span>
              </div>
            </div>

            <div class="flex items-center gap-4 w-full sm:w-auto">
              <div class="flex items-center gap-2 flex-1 sm:flex-initial">
                <span class="text-xs text-muted-adaptive">Vol:</span>
                <input type="range" min="0" max="1" step="0.05" value="${track.volume}" class="vol-slider w-24 accent-[#0066cc]" data-idx="${idx}" />
                <span class="text-xs font-mono text-[#0066cc] dark:text-[#2997ff] font-bold w-10 text-right">${Math.round(track.volume * 100)}%</span>
              </div>

              <button class="remove-track-btn text-xs text-red-500 hover:text-red-600 px-2 py-1 rounded hover:bg-red-500/10 transition-colors" data-idx="${idx}">
                ✕ Remove
              </button>
            </div>
          `;

          tracksContainer.appendChild(trackCard);
        });

        // Update summary
        if (totalDurEl) {
          const totM = Math.floor(Math.max(0, totalSec) / 60);
          const totS = Math.floor(Math.max(0, totalSec) % 60);
          totalDurEl.textContent = `${totM}:${String(totS).padStart(2, '0')}`;
        }
        if (trackCountEl) trackCountEl.textContent = `${loadedTracks.length} tracks loaded`;

        // Wire volume sliders and remove buttons
        tracksContainer.querySelectorAll<HTMLInputElement>('.vol-slider').forEach(sl => {
          sl.addEventListener('input', (e: any) => {
            const index = parseInt(e.target.dataset.idx, 10);
            loadedTracks[index].volume = parseFloat(e.target.value);
            const valLabel = e.target.nextElementSibling;
            if (valLabel) valLabel.textContent = `${Math.round(loadedTracks[index].volume * 100)}%`;
          });
        });

        tracksContainer.querySelectorAll<HTMLButtonElement>('.remove-track-btn').forEach(btn => {
          btn.addEventListener('click', (e: any) => {
            const index = parseInt(e.target.dataset.idx, 10);
            loadedTracks.splice(index, 1);
            renderTracksList();
          });
        });
      }

      modeSelect?.addEventListener('change', renderTracksList);
      crossfadeInput?.addEventListener('input', renderTracksList);

      window.addEventListener('audio-custom-download', ((e: CustomEvent) => {
        if (loadedTracks.length === 0) return;
        e.preventDefault();

        const btnText = document.getElementById('download-btn-text');
        if (btnText) btnText.textContent = 'Merging & Layering Audio Tracks...';

        try {
          const mode = modeSelect?.value.includes('Overlay') ? 'overlay' : 'sequential';
          const crossfade = parseFloat(crossfadeInput?.value || '0');

          const mergedBuffer = renderMergedTracks(loadedTracks, mode, crossfade);
          const wavBlob = audioBufferToWav(mergedBuffer, 16);
          downloadBlob(wavBlob, `master_merged_mix.wav`);
        } catch (err) {
          console.error('Merge error:', err);
        } finally {
          if (btnText) btnText.textContent = 'Process & Download Audio';
        }
      }) as EventListener);
    }

    setupAudioMerger();
    document.addEventListener('astro:page-load', setupAudioMerger);
  </script>
</Layout>
