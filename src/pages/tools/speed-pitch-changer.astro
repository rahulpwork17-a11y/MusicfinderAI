---
// src/pages/tools/speed-pitch-changer.astro
import Layout from '../../layouts/Layout.astro';
import InteractiveAudioTool from '../../components/InteractiveAudioTool.astro';

const controls = [
  { id: 'speed', label: 'Playback Speed / Tempo', type: 'slider' as const, min: 0.5, max: 2.0, step: 0.05, default: 1.0, unit: 'x' },
  { id: 'pitch', label: 'Pitch Transposition (Semiktones)', type: 'slider' as const, min: -12, max: 12, step: 1, default: 0, unit: ' semitones' },
  { id: 'preset', label: 'Quick Audio Style Preset', type: 'select' as const, default: 'Custom Neutral', options: ['Custom Neutral', 'Nightcore (Speed +25%, Pitch +3)', 'Slowed & Reverb (Speed -15%, Pitch -2)', 'Vaporwave (Speed -25%)'] },
];
---

<Layout title="Speed & Pitch Changer - Music Finder AI" subnavTitle="Speed & Pitch" activeTool="Speed/Pitch">
  <InteractiveAudioTool
    toolName="Speed & Pitch Shifter Transposer"
    toolDescription="Transpose pitch and adjust playback speed independently or together in real-time. Create Nightcore or Slowed & Reverb edits."
    icon="⏩"
    badge="Real-Time Pitch Shift"
    controls={controls}
    exportFormats={["MP3 (320kbps)", "WAV", "FLAC"]}
  />
</Layout>
