---
// src/components/InteractiveAudioTool.astro
interface ToolControl {
  id: string;
  label: string;
  type: 'slider' | 'toggle' | 'select';
  min?: number;
  max?: number;
  default?: number | string;
  step?: number;
  unit?: string;
  options?: string[];
}

interface Props {
  toolName: string;
  toolDescription: string;
  icon: string;
  badge?: string;
  controls?: ToolControl[];
  exportFormats?: string[];
  showSlotInitially?: boolean;
}

const {
  toolName,
  toolDescription,
  icon,
  badge = "Browser Processing",
  controls = [],
  exportFormats = ["WAV (Lossless)", "MP3 Master", "FLAC"],
  showSlotInitially = false
} = Astro.props;
---

<section class="py-12 px-4 md:px-8 bg-canvas">
  <div class="max-w-[1060px] mx-auto">
    
    <!-- Tool Header -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0066cc]/10 text-[#0066cc] dark:text-[#2997ff] text-xs font-semibold uppercase tracking-wider mb-3">
        <span>{icon}</span>
        <span>{badge}</span>
      </div>
      <h1 class="font-display font-semibold text-3xl md:text-5xl text-ink tracking-tight mb-3">
        {toolName}
      </h1>
      <p class="text-lg md:text-xl text-muted-adaptive max-w-2xl mx-auto leading-relaxed">
        {toolDescription}
      </p>
    </div>

    <!-- WebAudio DAW Workspace Card -->
    <div class="bg-surface-card rounded-[24px] border border-adaptive p-6 md:p-10 shadow-sm space-y-8">
      
      <!-- Upload Dropzone for Tool -->
      <div id="tool-dropzone" class="border-2 border-dashed border-adaptive hover:border-[#0066cc] bg-canvas rounded-[20px] p-8 text-center transition-all cursor-pointer group">
        <input type="file" id="tool-file-input" accept="audio/*,video/*" class="hidden" />
        <div class="w-12 h-12 rounded-full bg-parchment text-[#0066cc] dark:text-[#2997ff] mx-auto flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
        </div>
        <h4 class="font-semibold text-lg text-ink">Drop audio file to process</h4>
        <p class="text-xs text-muted-adaptive mt-1">MP3, WAV, FLAC, M4A, AAC, OGG supported &bull; 100% Private Client-Side</p>
      </div>

      <!-- Active Processing Screen (Hidden by default) -->
      <div id="tool-workspace" class="hidden space-y-6">
        
        <!-- File Header & Playback Bar -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-adaptive">
          <div class="flex items-center gap-3">
            <span class="text-2xl">{icon}</span>
            <div>
              <h4 id="tool-filename" class="font-semibold text-base text-ink">Audio Track.mp3</h4>
              <div class="flex items-center gap-2 text-xs text-[#0066cc] dark:text-[#2997ff] font-medium">
                <span id="tool-file-duration">0:00</span>
                <span>&bull;</span>
                <span id="tool-sample-rate">44.1 kHz</span>
                <span>&bull;</span>
                <span id="tool-status-text">Ready for real-time processing</span>
              </div>
            </div>
          </div>
          
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <button id="tool-play-pause" class="btn-action-primary !py-2 !px-5 text-sm flex items-center justify-center gap-2 flex-1 sm:flex-initial">
              <span id="play-icon">▶</span>
              <span id="play-text">Play Preview</span>
            </button>
            <button id="tool-reset-btn" class="px-3 py-2 rounded-xl border border-adaptive hover:bg-canvas text-xs font-medium text-ink transition-colors">
              ✕ Replace File
            </button>
          </div>
        </div>

        <!-- Real-time WebAudio Visualizer Canvas & Timeline Tracker -->
        <div class="bg-black p-4 rounded-xl relative border border-adaptive overflow-hidden group">
          <canvas id="tool-canvas" class="w-full h-32 rounded-lg bg-black/60 block"></canvas>
          <div class="flex items-center justify-between text-[11px] font-mono text-neutral-400 mt-2 px-1">
            <span id="time-current">0:00.0</span>
            <span class="text-[10px] text-neutral-500 uppercase tracking-wider">WebAudio FFT Visualizer</span>
            <span id="time-total">0:00.0</span>
          </div>
        </div>

        <!-- Custom Tool Controls Grid -->
        {controls.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-canvas p-6 rounded-2xl border border-adaptive">
            {controls.map((ctrl) => (
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <label for={ctrl.id} class="text-sm font-semibold text-ink">{ctrl.label}</label>
                  <span id={`val-${ctrl.id}`} class="text-xs font-mono text-[#0066cc] dark:text-[#2997ff] bg-[#0066cc]/10 px-2 py-0.5 rounded">
                    {ctrl.default}{ctrl.unit || ''}
                  </span>
                </div>
                {ctrl.type === 'slider' && (
                  <input
                    type="range"
                    id={ctrl.id}
                    min={ctrl.min || 0}
                    max={ctrl.max || 100}
                    step={ctrl.step || 1}
                    value={ctrl.default || 50}
                    class="w-full accent-[#0066cc] cursor-pointer"
                  />
                )}
                {ctrl.type === 'select' && (
                  <select id={ctrl.id} class="w-full px-3 py-2 rounded-lg border border-adaptive text-sm bg-surface-card text-ink focus:outline-none focus:border-[#0066cc]">
                    {ctrl.options?.map((opt) => (
                      <option value={opt}>{opt}</option>
                    ))}
                  </select>
                )}
              </div>
            ))}
          </div>
        )}

        <!-- Additional Tool Custom Slot (when tied to file upload) -->
        {!showSlotInitially && <slot />}

        <!-- Export & Action Bar -->
        <div class="pt-4 border-t border-adaptive flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-2 text-xs text-muted-adaptive flex-wrap">
            <span>Export Format:</span>
            {exportFormats.map((fmt, idx) => (
              <button
                type="button"
                data-fmt={fmt}
                class={`export-fmt-btn px-2.5 py-1 rounded-md border text-xs font-medium cursor-pointer transition-all ${
                  idx === 0
                    ? 'bg-[#0066cc] text-white border-[#0066cc]'
                    : 'bg-canvas border-adaptive hover:border-[#0066cc] text-ink'
                }`}
              >
                {fmt}
              </button>
            ))}
          </div>

          <button id="process-download-btn" class="btn-action-primary !py-3 !px-8 text-base w-full sm:w-auto shadow-md flex items-center justify-center gap-2">
            <span>⬇</span>
            <span id="download-btn-text">Process & Download Audio</span>
          </button>
        </div>

      </div>

      <!-- Additional Tool Custom Slot (when active initially like Tap Tempo) -->
      {showSlotInitially && <slot />}

    </div>

  </div>
</section>

<script>
  import { decodeAudioFile, audioBufferToWav, downloadBlob } from '../utils/audioEngine';

  function setupToolWorkspace() {
    const dropzone = document.getElementById('tool-dropzone');
    const input = document.getElementById('tool-file-input') as HTMLInputElement;
    const workspace = document.getElementById('tool-workspace');
    const filenameEl = document.getElementById('tool-filename');
    const durationEl = document.getElementById('tool-file-duration');
    const sampleRateEl = document.getElementById('tool-sample-rate');
    const statusTextEl = document.getElementById('tool-status-text');
    const canvas = document.getElementById('tool-canvas') as HTMLCanvasElement;
    const playBtn = document.getElementById('tool-play-pause');
    const playIcon = document.getElementById('play-icon');
    const playText = document.getElementById('play-text');
    const resetBtn = document.getElementById('tool-reset-btn');
    const downloadBtn = document.getElementById('process-download-btn');
    const timeCurrentEl = document.getElementById('time-current');
    const timeTotalEl = document.getElementById('time-total');
    const exportButtons = document.querySelectorAll('.export-fmt-btn');

    let currentFile: File | null = null;
    let currentBuffer: AudioBuffer | null = null;
    let audioCtx: AudioContext | null = null;
    let currentSource: AudioBufferSourceNode | null = null;
    let isPlaying = false;
    let startTime = 0;
    let pauseOffset = 0;
    let animFrameId: number | null = null;
    let selectedFormat = (exportButtons[0] as HTMLElement)?.dataset?.fmt || 'WAV';

    // Format selection handler
    exportButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        exportButtons.forEach((b) => {
          b.classList.remove('bg-[#0066cc]', 'text-white', 'border-[#0066cc]');
          b.classList.add('bg-canvas', 'border-adaptive', 'text-ink');
        });
        btn.classList.remove('bg-canvas', 'border-adaptive', 'text-ink');
        btn.classList.add('bg-[#0066cc]', 'text-white', 'border-[#0066cc]');
        selectedFormat = (btn as HTMLElement).dataset?.fmt || 'WAV';
      });
    });

    // Dropzone Drag & Drop
    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-[#0066cc]', 'bg-[#0066cc]/5');
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-[#0066cc]', 'bg-[#0066cc]/5');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-[#0066cc]', 'bg-[#0066cc]/5');
      if (e.dataTransfer?.files?.length) {
        handleFileSelection(e.dataTransfer.files[0]);
      }
    });

    dropzone?.addEventListener('click', () => input?.click());

    input?.addEventListener('change', (e: any) => {
      const file = e.target.files?.[0];
      if (file) {
        handleFileSelection(file);
      }
    });

    resetBtn?.addEventListener('click', () => {
      stopAudio();
      currentFile = null;
      currentBuffer = null;
      if (input) input.value = '';
      workspace?.classList.add('hidden');
      dropzone?.classList.remove('hidden');
      window.dispatchEvent(new CustomEvent('audio-reset'));
    });

    async function handleFileSelection(file: File) {
      currentFile = file;
      if (filenameEl) filenameEl.textContent = file.name;
      if (statusTextEl) statusTextEl.textContent = 'Decoding audio data...';
      if (workspace) workspace.classList.remove('hidden');
      dropzone?.classList.add('hidden');

      try {
        currentBuffer = await decodeAudioFile(file);
        if (durationEl) {
          const m = Math.floor(currentBuffer.duration / 60);
          const s = Math.floor(currentBuffer.duration % 60);
          durationEl.textContent = `${m}:${String(s).padStart(2, '0')}`;
          if (timeTotalEl) timeTotalEl.textContent = `${m}:${String(s).padStart(2, '0')}.0`;
        }
        if (sampleRateEl) {
          sampleRateEl.textContent = `${(currentBuffer.sampleRate / 1000).toFixed(1)} kHz`;
        }
        if (statusTextEl) statusTextEl.textContent = 'Ready for processing';

        // Draw audio buffer waveform
        drawWaveform(currentBuffer);

        // Dispatch custom event with buffer for tool page scripts
        window.dispatchEvent(new CustomEvent('audio-loaded', {
          detail: {
            file,
            buffer: currentBuffer,
            filename: file.name
          }
        }));
      } catch (err) {
        console.error('Audio decode error:', err);
        if (statusTextEl) statusTextEl.textContent = 'Error decoding audio file';
      }
    }

    function drawWaveform(buffer: AudioBuffer, progressFraction: number = 0) {
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      canvas.width = canvas.parentElement?.clientWidth || 600;
      canvas.height = 128;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const pcm = buffer.getChannelData(0);
      const step = Math.ceil(pcm.length / canvas.width);
      const amp = canvas.height / 2;

      // Draw background grid lines
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, amp);
      ctx.lineTo(canvas.width, amp);
      ctx.stroke();

      // Draw waveform bars
      const progressX = canvas.width * progressFraction;

      for (let i = 0; i < canvas.width; i++) {
        let min = 1.0;
        let max = -1.0;
        for (let j = 0; j < step; j++) {
          const datum = pcm[i * step + j];
          if (datum < min) min = datum;
          if (datum > max) max = datum;
        }

        const barHeight = Math.max(2, (max - min) * amp * 0.9);
        const isPlayed = i <= progressX;

        ctx.fillStyle = isPlayed ? '#2997ff' : '#0066cc';
        ctx.fillRect(i, amp - barHeight / 2, 1, barHeight);
      }

      // Draw playhead cursor
      if (isPlaying) {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(progressX, 0, 2, canvas.height);
      }
    }

    function playAudio() {
      if (!currentBuffer) return;
      if (!audioCtx || audioCtx.state === 'closed') {
        audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      }

      currentSource = audioCtx.createBufferSource();
      currentSource.buffer = currentBuffer;
      currentSource.connect(audioCtx.destination);

      currentSource.onended = () => {
        if (isPlaying) {
          stopAudio();
        }
      };

      currentSource.start(0, pauseOffset);
      startTime = audioCtx.currentTime - pauseOffset;
      isPlaying = true;
      if (playIcon) playIcon.textContent = '⏸';
      if (playText) playText.textContent = 'Pause';

      updatePlaybackLoop();
    }

    function stopAudio() {
      if (currentSource) {
        try { currentSource.stop(); } catch {}
        currentSource.disconnect();
        currentSource = null;
      }
      isPlaying = false;
      pauseOffset = 0;
      if (playIcon) playIcon.textContent = '▶';
      if (playText) playText.textContent = 'Play Preview';
      if (animFrameId) cancelAnimationFrame(animFrameId);
      if (currentBuffer) drawWaveform(currentBuffer, 0);
      if (timeCurrentEl) timeCurrentEl.textContent = '0:00.0';
    }

    function pauseAudio() {
      if (currentSource && audioCtx) {
        pauseOffset = audioCtx.currentTime - startTime;
        try { currentSource.stop(); } catch {}
        currentSource.disconnect();
        currentSource = null;
      }
      isPlaying = false;
      if (playIcon) playIcon.textContent = '▶';
      if (playText) playText.textContent = 'Resume Preview';
      if (animFrameId) cancelAnimationFrame(animFrameId);
    }

    function updatePlaybackLoop() {
      if (!isPlaying || !audioCtx || !currentBuffer) return;
      const current = audioCtx.currentTime - startTime;
      if (current >= currentBuffer.duration) {
        stopAudio();
        return;
      }

      const fraction = current / currentBuffer.duration;
      drawWaveform(currentBuffer, fraction);

      if (timeCurrentEl) {
        const m = Math.floor(current / 60);
        const s = Math.floor(current % 60);
        const ms = Math.floor((current % 1) * 10);
        timeCurrentEl.textContent = `${m}:${String(s).padStart(2, '0')}.${ms}`;
      }

      animFrameId = requestAnimationFrame(updatePlaybackLoop);
    }

    playBtn?.addEventListener('click', () => {
      if (isPlaying) {
        pauseAudio();
      } else {
        playAudio();
      }
    });

    // Default download handler if no tool-specific override exists
    downloadBtn?.addEventListener('click', () => {
      const customDownloadEvent = new CustomEvent('audio-custom-download', {
        cancelable: true,
        detail: {
          file: currentFile,
          buffer: currentBuffer,
          format: selectedFormat
        }
      });
      const handled = !window.dispatchEvent(customDownloadEvent);

      // Fallback default download if custom tool did not prevent default
      if (!handled && currentBuffer && currentFile) {
        const wavBlob = audioBufferToWav(currentBuffer, 16);
        const outName = currentFile.name.replace(/\.[^/.]+$/, "") + `_processed.wav`;
        downloadBlob(wavBlob, outName);
      }
    });

    // Handle range value updates dynamically
    document.querySelectorAll('input[type="range"]').forEach((rng) => {
      rng.addEventListener('input', (e: any) => {
        const valSpan = document.getElementById(`val-${e.target.id}`);
        if (valSpan) {
          const unit = rng.parentElement?.querySelector('span')?.textContent?.replace(/[0-9.-]/g, '') || '';
          valSpan.textContent = `${e.target.value}${unit.trim()}`;
        }
      });
    });
  }

  setupToolWorkspace();
  document.addEventListener('astro:page-load', setupToolWorkspace);
</script>
