---
// src/components/SubNavFrosted.astro
interface Props {
  title?: string;
  activeTool?: string;
}

const { title = "Studio Hub", activeTool = "" } = Astro.props;

const tools = [
  { name: "All Tools", href: "/tools" },
  { name: "Converter", href: "/tools/media-converter" },
  { name: "MIDI", href: "/tools/audio-to-midi" },
  { name: "Equalizer", href: "/tools/equalizer" },
  { name: "Transcriber", href: "/tools/audio-transcriber" },
  { name: "Stems", href: "/tools/stem-splitter" },
  { name: "Merger", href: "/tools/audio-merger" },
  { name: "Trimmer", href: "/tools/audio-trimmer" },
  { name: "BPM", href: "/tools/bpm-detector" },
  { name: "Key", href: "/tools/key-detector" },
  { name: "Mood", href: "/tools/mood-detector" },
  { name: "Noise", href: "/tools/noise-remover" },
  { name: "Reverb", href: "/tools/reverb-remover" },
  { name: "Speed/Pitch", href: "/tools/speed-pitch-changer" },
];
---

<div class="sticky top-[44px] z-40 h-[52px] frosted-glass border-b border-adaptive flex items-center px-4 md:px-8">
  <div class="max-w-[1440px] w-full mx-auto flex items-center justify-between gap-4 overflow-x-auto no-scrollbar">
    <!-- Category Tagline / Page Title -->
    <div class="flex items-center gap-3 shrink-0">
      <!-- 21px per {typography.tagline} in DESIGN.md -->
      <span class="font-display font-semibold text-[21px] text-ink tracking-tight">{title}</span>
      <span class="text-neutral-400 text-sm hidden lg:inline">|</span>
      <span class="text-neutral-500 dark:text-neutral-400 text-xs font-normal hidden lg:inline">Audio Intelligence & WebAudio DAW Studio</span>
    </div>

    <!-- Quick Pill Nav Items — masked edges signal horizontal scrollability -->
    <div class="relative shrink-0">
      <div
        class="flex items-center gap-1.5 overflow-x-auto py-1 scrollbar-none"
        style="mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);"
      >
      {tools.map((t) => {
        const isActive = activeTool === t.name || (t.name === "All Tools" && activeTool === "Directory");
        return (
          <a
            href={t.href}
            class={`px-3 py-1 text-[13px] rounded-full transition-all whitespace-nowrap no-underline ${
              isActive
                ? "bg-[#0066cc] text-white font-medium shadow-sm"
                : "bg-surface-card hover:bg-canvas text-ink hover:text-[#0066cc] border border-adaptive"
            }`}
          >
            {t.name}
          </a>
        );
      })}
      </div>
    </div>

    <!-- Primary Action Pill -->
    <div class="shrink-0 hidden md:flex items-center">
      <a href="/#recognizer" class="btn-action-primary !text-[13px] font-medium !px-4 !py-1.5 no-underline flex items-center gap-1.5 shadow-sm">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
        </svg>
        <span>Upload & Identify</span>
      </a>
    </div>
  </div>
</div>
