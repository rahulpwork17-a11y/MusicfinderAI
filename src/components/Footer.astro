---
// src/components/Footer.astro
---

<footer class="bg-parchment text-ink border-t border-adaptive pt-16 pb-12 px-6 md:px-12 text-[14px]">
  <div class="max-w-[1440px] mx-auto">
    <!-- Top Specifications & Privacy Note -->
    <div class="pb-8 mb-8 border-b border-adaptive text-[12px] text-muted-adaptive leading-relaxed">
      <p class="mb-2">
        * Music Finder AI provides high-precision acoustic audio fingerprinting and recognition. All file uploads and audio streams are processed securely and immediately purged. Local preprocessing runs directly on client hardware for maximum speed and complete privacy.
      </p>
      <p>
        Supported Formats: MP3, WAV, FLAC, M4A, AAC, OGG, OPUS, ALAC, AIFF, MP4, WebM, MKV, AVI, MOV.
      </p>
    </div>

    <!-- 4-Column Link Hierarchy -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <!-- Column 1: AI Recognizer -->
      <div>
        <h4 class="font-semibold text-[14px] text-ink mb-3">Song Recognition</h4>
        <ul class="list-none p-0 m-0 text-[14px] leading-[2.41]">
          <li><a href="/#recognizer" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Identify Song by Audio</a></li>
          <li><a href="/#recognizer" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Identify Song by Video</a></li>
          <li><a href="/#recognizer" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Record Live Sound</a></li>
          <li><a href="/#recognizer" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Paste Media URL</a></li>
          <li><a href="/#history" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Recognition History</a></li>
        </ul>
      </div>

      <!-- Column 2: Technology & Features -->
      <div>
        <h4 class="font-semibold text-[14px] text-ink mb-3">Features & Tech</h4>
        <ul class="list-none p-0 m-0 text-[14px] leading-[2.41]">
          <li><a href="/technology" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Acoustic Fingerprinting</a></li>
          <li><a href="/technology" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Real-time Spectrogram FFT</a></li>
          <li><a href="/#recognizer" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Volume Normalization</a></li>
          <li><a href="/#recognizer" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Vocal Isolation Filter</a></li>
          <li><a href="/comparison" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Platform Comparison</a></li>
        </ul>
      </div>

      <!-- Column 3: Streaming Integrations -->
      <div>
        <h4 class="font-semibold text-[14px] text-ink mb-3">Integrations</h4>
        <ul class="list-none p-0 m-0 text-[14px] leading-[2.41]">
          <li><a href="https://spotify.com" target="_blank" rel="noopener" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Spotify Direct Link</a></li>
          <li><a href="https://music.apple.com" target="_blank" rel="noopener" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Apple Music Sync</a></li>
          <li><a href="https://youtube.com" target="_blank" rel="noopener" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">YouTube Music Search</a></li>
          <li><a href="/#faq" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">BPM & Key Extraction</a></li>
          <li><a href="/#faq" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">30s Match Audio Preview</a></li>
        </ul>
      </div>

      <!-- Column 4: Platform & Legal -->
      <div>
        <h4 class="font-semibold text-[14px] text-ink mb-3">Music Finder AI</h4>
        <ul class="list-none p-0 m-0 text-[14px] leading-[2.41]">
          <li><a href="/#faq" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">FAQ & How It Works</a></li>
          <li><a href="/technology" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Engine Specifications</a></li>
          <li><a href="/comparison" class="text-ink hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Platform Benchmarks</a></li>
          <li><span class="text-muted-adaptive">Version 2.4 Acoustic Engine</span></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-6 border-t border-adaptive flex flex-col md:flex-row items-center justify-between gap-4 text-[12px] text-muted-adaptive">
      <div>
        © 2026 Music Finder AI. All rights reserved. Built with Astro & Acoustic AI.
      </div>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Privacy Policy</a>
        <a href="/terms" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Terms of Service</a>
        <a href="/api" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors no-underline">Audio API</a>
      </div>
    </div>
  </div>
</footer>
