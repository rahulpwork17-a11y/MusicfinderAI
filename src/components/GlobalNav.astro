---
// src/components/GlobalNav.astro
const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="bg-black text-white h-[44px] sticky top-0 z-50 flex items-center px-4 md:px-8 border-b border-neutral-900 text-[12px] font-normal tracking-tight">
  <div class="max-w-[1440px] w-full mx-auto flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 text-white hover:opacity-90 transition-opacity no-underline">
      <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-[#0066cc] via-indigo-500 to-purple-500 flex items-center justify-center p-[1px]">
        <div class="w-full h-full bg-black rounded-full flex items-center justify-center">
          <svg class="w-3.5 h-3.5 text-[#2997ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 .895-2 3-2 3 .895 3 2zm12 0c0 1.105-1.343 2-3 2s-3-.895-3-2 .895-2 3-2 3 .895 3 2z" />
          </svg>
        </div>
      </div>
      <span class="font-semibold text-[15px] tracking-tight">Music Finder <span class="text-[#2997ff] font-bold">AI</span></span>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-neutral-300">
      <a href="/#recognizer" class="hover:text-white transition-colors no-underline">Recognizer</a>
      <a href="/#technology" class="hover:text-white transition-colors no-underline">Technology</a>
      <a href="/#comparison" class="hover:text-white transition-colors no-underline">Comparison</a>
      <a href="/#faq" class="hover:text-white transition-colors no-underline">FAQ</a>
    </nav>

    <!-- Utility Cluster (Theme Toggle + History + Identify CTA) -->
    <div class="flex items-center gap-2 sm:gap-3">
      
      <!-- Theme Switcher Button -->
      <button
        id="theme-toggle-btn"
        class="bg-neutral-900 hover:bg-neutral-800 text-neutral-200 hover:text-white px-2.5 py-1 rounded-full border border-neutral-800 text-[12px] flex items-center gap-1 transition-all active:scale-95 cursor-pointer"
        aria-label="Toggle Light and Dark Mode"
        title="Toggle Theme"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-icon-sun" class="w-3.5 h-3.5 text-amber-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-icon-moon" class="w-3.5 h-3.5 text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span id="theme-btn-text" class="hidden sm:inline text-[11px]">Theme</span>
      </button>

      <!-- History Button -->
      <button 
        id="toggle-history-btn" 
        class="bg-neutral-900 hover:bg-neutral-800 text-neutral-200 hover:text-white px-3 py-1 rounded-full border border-neutral-800 text-[12px] flex items-center gap-1.5 transition-all active:scale-95 cursor-pointer"
        title="View Recognition History"
      >
        <svg class="w-3.5 h-3.5 text-[#2997ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>History</span>
      </button>

      <a href="/#recognizer" class="btn-action-primary !text-[12px] !py-1 !px-3.5 !min-h-0 hidden sm:inline-flex">
        Identify Song
      </a>
    </div>
  </div>
</header>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const btnText = document.getElementById('theme-btn-text');

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (sunIcon && moonIcon) {
        if (isDark) {
          sunIcon.classList.remove('hidden');
          moonIcon.classList.add('hidden');
          if (btnText) btnText.textContent = 'Light';
        } else {
          sunIcon.classList.add('hidden');
          moonIcon.classList.remove('hidden');
          if (btnText) btnText.textContent = 'Dark';
        }
      }
    }

    updateIcons();

    btn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('musicfinder_theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('musicfinder_theme', 'dark');
      }
      updateIcons();
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
